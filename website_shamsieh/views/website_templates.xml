<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="shamsieh_fonts" inherit_id="web.layout" name="Shamsieh Fonts">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&amp;family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&amp;display=swap" rel="stylesheet"/>
        </xpath>
    </template>

    <!-- Site-wide mark so nav/footer Solar styles apply across header variants.
         Odoo 19 uses t-attf-class on #wrapwrap (static class= is ignored / emptied). -->
    <template id="shamsieh_layout_mark" inherit_id="website.layout" name="Shamsieh Layout Mark" priority="99">
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="t-attf-class" add="shamsieh-site" separator=" "/>
        </xpath>
    </template>

    <!-- Mark header for Solar nav styling. Inherit website.layout (same parent
         as header_visibility_standard) and append via t-attf-class. -->
    <template id="header_shamsieh" inherit_id="website.layout" name="Shamsieh Header" priority="99">
        <xpath expr="//header" position="attributes">
            <attribute name="t-attf-class" add="shamsieh-header" separator=" "/>
        </xpath>
    </template>

    <!-- Logo + wordmark (sun mark from shamsieh.education brand) -->
    <template id="brand_shamsieh" inherit_id="website.option_header_brand_logo" name="Shamsieh Brand Wordmark" priority="99">
        <xpath expr="//a[contains(@t-attf-class, 'navbar-brand')]" position="replace">
            <a data-name="Navbar Logo" href="/" t-attf-class="navbar-brand logo shamsieh-wordmark #{_link_class or ''}">
                <img class="shamsieh-wordmark__mark"
                     src="/website_shamsieh/static/src/img/shamsieh-logo.svg"
                     alt=""
                     width="42"
                     height="32"/>
                <span class="shamsieh-wordmark__text">Shamsieh</span>
            </a>
        </xpath>
    </template>

    <!-- Floating logo ball (brand mark, back-to-top) -->
    <template id="shamsieh_float_logo" inherit_id="website.layout" name="Shamsieh Float Logo" priority="99">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <a href="/#top" class="shamsieh-float-logo" aria-label="Shamsieh home" title="Shamsieh">
                <img src="/website_shamsieh/static/src/img/shamsieh-logo.svg" alt="Shamsieh" width="32" height="24"/>
            </a>
        </xpath>
    </template>

    <!-- In-page anchors: top_menu ul lives on website.navbar_nav (not website.navbar) -->
    <template id="navbar_menu_shamsieh" inherit_id="website.navbar_nav" name="Shamsieh Navbar Menu" priority="99">
        <xpath expr="//ul[contains(@t-attf-class, 'top_menu')]" position="replace">
            <ul t-att-id="not is_mobile and 'top_menu'"
                t-attf-class="nav navbar-nav top_menu shamsieh-nav-menu #{'' if _no_autohide_menu_mobile else 'o_menu_loading'} #{is_vertical_nav and 'o_mega_menu_is_offcanvas mx-n3'} #{_nav_class} #{(_navbar_pills and not is_mobile) and 'nav-pills'} ms-auto"
                role="menu">
                <li class="nav-item" role="presentation">
                    <a href="/#about" class="nav-link" role="menuitem">About</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a href="/#products" class="nav-link" role="menuitem">Products</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a href="/#industries" class="nav-link" role="menuitem">Industries</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a href="/#talent" class="nav-link" role="menuitem">Talent</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a href="/#contact" class="nav-link" role="menuitem">Contact</a>
                </li>
            </ul>
        </xpath>
    </template>

    <!-- Solar footer -->
    <template id="footer_shamsieh" inherit_id="website.footer_custom" name="Shamsieh Footer" active="True" priority="99">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo shamsieh-footer text-break" t-ignore="true" t-if="not no_footer">
                <section class="s_text_block" data-snippet="s_text_block">
                    <div class="container">
                        <div class="shamsieh-footer-inner">
                            <div>
                                <div class="shamsieh-footer-brand">
                                    <img src="/website_shamsieh/static/src/img/shamsieh-logo.svg" alt="" width="36" height="27" style="vertical-align:middle;margin-right:0.45rem;"/>
                                    Shamsieh <span>Technology</span>
                                </div>
                                <p class="shamsieh-footer-copy">
                                    Products. Platforms. People. A regional technology company building software
                                    products, implementing business platforms, and supporting organizations with
                                    specialized technology expertise.
                                </p>
                            </div>
                            <div>
                                <h5>Explore</h5>
                                <ul>
                                    <li><a href="/#about">About</a></li>
                                    <li><a href="/#products">Products</a></li>
                                    <li><a href="/#industries">Industries</a></li>
                                    <li><a href="/#talent">Talent</a></li>
                                    <li><a href="/#contact">Contact</a></li>
                                </ul>
                            </div>
                            <div>
                                <h5>Call us</h5>
                                <ul>
                                    <li><a href="tel:+962775999908">+962 7 7599 9908 · JO</a></li>
                                    <li><a href="tel:+966563447279">+966 56 344 7279 · SA</a></li>
                                </ul>
                            </div>
                            <div>
                                <h5>Address</h5>
                                <ul>
                                    <li>Zahran St 34, Amman, Jordan</li>
                                    <li>Murabba 6479, Riyadh, Saudi Arabia</li>
                                </ul>
                            </div>
                        </div>
                        <div class="shamsieh-footer-bottom">
                            <span>© 2026 Shamsieh Technology Services</span>
                            <span>Jordan · Saudi Arabia</span>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
