<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_attendance_custom" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.attendance.custom</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_attendance']/block[.//field[@name='attendance_kiosk_url']]" position="replace"/>
            <xpath expr="//field[@name='attendance_kiosk_mode']/ancestor::setting[1]" position="replace"/>
            <xpath expr="//app[@name='hr_attendance']/block[@name='kiosk_mode_setting_container']" position="after">
                <block title="Shamsieh Custom Attendance" name="shamsieh_attendance_custom_block">
                    <setting string="Missing Checkout Tolerance" company_dependent="1"
                             help="Hours after the employee's scheduled calendar end before an open attendance is flagged as missing checkout.">
                        <span class="me-2">Tolerance</span>
                        <field name="missing_checkout_tolerance_hours" class="text-center" style="width: 5ch;"/>
                        <span class="ms-2">Hours</span>
                    </setting>
                    <setting string="Face Provider" company_dependent="1">
                        <field name="face_provider"/>
                    </setting>
                    <setting string="Face Attendance Stub (Development)" company_dependent="1"
                             help="Auto-pass face verification without InsightFace. Disable in production.">
                        <field name="face_attendance_stub_enabled"/>
                    </setting>
                    <setting string="Face Match Threshold" company_dependent="1"
                             invisible="face_attendance_stub_enabled"
                             help="Minimum cosine similarity required for face verification.">
                        <field name="face_match_threshold" class="text-center" style="width: 6ch;"/>
                    </setting>
                    <setting string="Face Quality Checks" company_dependent="1"
                             invisible="face_attendance_stub_enabled">
                        <field name="face_quality_check_enabled"/>
                    </setting>
                    <setting string="Store Raw Face Images" company_dependent="1"
                             invisible="face_attendance_stub_enabled"
                             help="When enabled, enrollment images may be stored as attachments.">
                        <field name="face_store_raw_images"/>
                    </setting>
                    <setting string="Office Geo Reference Point" company_dependent="1"
                             help="Office check-ins are rejected when outside this radius. Falls back to the employee office work address coordinates when unset.">
                        <div class="d-flex gap-2 align-items-center">
                            <field name="office_geo_latitude" placeholder="Latitude"/>
                            <field name="office_geo_longitude" placeholder="Longitude"/>
                        </div>
                    </setting>
                    <setting string="Office Geo Radius" company_dependent="1"
                             help="Allowed geolocation distance in meters from the office reference point.">
                        <field name="office_geo_radius_meters" class="text-center" style="width: 6ch;"/>
                        <span class="ms-2">meters</span>
                    </setting>
                    <setting string="Liveness Required" company_dependent="1"
                             invisible="face_attendance_stub_enabled"
                             help="Reserved for future advanced liveness detection.">
                        <field name="face_liveness_required" readonly="1"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
