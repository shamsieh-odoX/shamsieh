<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_face_enroll_wizard_form" model="ir.ui.view">
        <field name="name">hr.employee.face.enroll.wizard.form</field>
        <field name="model">hr.employee.face.enroll.wizard</field>
        <field name="arch" type="xml">
            <form string="Enroll Face Template">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="notes"
                                   placeholder="Optional notes about lighting, angle, or device used…"/>
                        </group>
                        <group string="Enrollment Photo">
                            <field name="enrollment_image"
                                   filename="enrollment_image_filename"
                                   widget="image"
                                   class="oe_avatar"
                                   options="{'size': [256, 256]}"/>
                            <field name="enrollment_image_filename" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_enroll" type="object" string="Enroll" class="btn-primary" icon="fa-check"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
