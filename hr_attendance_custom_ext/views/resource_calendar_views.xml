<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_resource_calendar_attendance_tree_inherit_attendance_custom" model="ir.ui.view">
        <field name="name">resource.calendar.attendance.tree.attendance.custom</field>
        <field name="model">resource.calendar.attendance</field>
        <field name="inherit_id" ref="resource.view_resource_calendar_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='day_period']" position="after">
                <field name="location_type"/>
            </xpath>
        </field>
    </record>

    <record id="view_resource_calendar_attendance_form_inherit_attendance_custom" model="ir.ui.view">
        <field name="name">resource.calendar.attendance.form.attendance.custom</field>
        <field name="model">resource.calendar.attendance</field>
        <field name="inherit_id" ref="resource.view_resource_calendar_attendance_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='day_period']" position="after">
                <field name="location_type"/>
            </xpath>
        </field>
    </record>
</odoo>
