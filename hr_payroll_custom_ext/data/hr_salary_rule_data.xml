<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Unworked Time Deduction -->
    <record id="salary_rule_unworked_deduction" model="hr.salary.rule">
        <field name="name">Unworked Time Deduction</field>
        <field name="code">UNWORKED_DED</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="struct_id" ref="hr_payroll.default_payroll_structure"/>
        <field name="sequence">150</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = inputs.get('UNWORKED_DEDUCTION') and inputs['UNWORKED_DEDUCTION'].amount > 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = -inputs['UNWORKED_DEDUCTION'].amount</field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

