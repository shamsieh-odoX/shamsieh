<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.botify_agent</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Botify Agent" string="Botify Agent" name="botify_agent" groups="base.group_system">
                    <block title="Connection" name="botify_connection">
                        <setting id="botify_enabled_setting" string="Botify agent"
                                 help="Employees in the group Botify Agent user get the assistant, acting with their own Odoo permissions.">
                            <field name="botify_enabled"/>
                            <div class="content-group mt16">
                                <div><label for="botify_api_url" class="o_light_label"/><field name="botify_api_url" placeholder="https://api.botify.example"/></div>
                                <div><label for="botify_installation_key" class="o_light_label"/><field name="botify_installation_key" placeholder="wsk_…"/></div>
                                <div><label for="botify_secret" class="o_light_label"/><field name="botify_secret" password="True"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="What the agent may do (Botify must allow it too)" name="botify_rollout">
                        <setting id="botify_classes_setting" string="Operation classes"
                                 help="Reading is always allowed. Every class also needs the employee's own Odoo rights.">
                            <div class="content-group">
                                <div><field name="botify_allow_low_write"/><label for="botify_allow_low_write" class="o_light_label"/></div>
                                <div><field name="botify_allow_high_write"/><label for="botify_allow_high_write" class="o_light_label"/></div>
                                <div><field name="botify_allow_financial"/><label for="botify_allow_financial" class="o_light_label"/></div>
                                <div><field name="botify_allow_destructive"/><label for="botify_allow_destructive" class="o_light_label"/></div>
                                <div><field name="botify_allow_external_communication"/><label for="botify_allow_external_communication" class="o_light_label"/></div>
                            </div>
                        </setting>
                        <setting id="botify_retention_setting" string="Operation log">
                            <field name="botify_retention_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
