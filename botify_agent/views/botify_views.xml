<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="botify_operation_view_list" model="ir.ui.view">
        <field name="name">botify.agent.operation.list</field>
        <field name="model">botify.agent.operation</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="company_id" optional="hide"/>
                <field name="operation"/>
                <field name="model"/>
                <field name="method"/>
                <field name="record_ids"/>
                <field name="risk_class"/>
                <field name="status" decoration-danger="status in ('failed', 'aborted')" decoration-success="status == 'done'"/>
                <field name="error_code" optional="show"/>
                <field name="latency_ms" optional="hide"/>
                <field name="call_id" optional="hide"/>
                <field name="run_id" optional="hide"/>
                <field name="approval_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="botify_operation_view_search" model="ir.ui.view">
        <field name="name">botify.agent.operation.search</field>
        <field name="model">botify.agent.operation</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="model"/>
                <field name="call_id"/>
                <field name="run_id"/>
                <filter name="failed" string="Failed" domain="[('status', 'in', ('failed', 'aborted'))]"/>
            </search>
        </field>
    </record>

    <record id="botify_event_view_list" model="ir.ui.view">
        <field name="name">botify.agent.event.list</field>
        <field name="model">botify.agent.event</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="company_id" optional="hide"/>
                <field name="kind"/>
                <field name="state" decoration-danger="state in ('failed', 'expired')" decoration-success="state == 'delivered'"/>
                <field name="attempts"/>
                <field name="delivered_at" optional="show"/>
                <field name="last_error" optional="show"/>
                <field name="facts_json" optional="hide"/>
                <field name="event_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="botify_event_view_search" model="ir.ui.view">
        <field name="name">botify.agent.event.search</field>
        <field name="model">botify.agent.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="kind"/>
                <field name="event_id"/>
                <filter name="undelivered" string="Not delivered" domain="[('state', '!=', 'delivered')]"/>
            </search>
        </field>
    </record>

    <record id="botify_method_view_list" model="ir.ui.view">
        <field name="name">botify.agent.method.list</field>
        <field name="model">botify.agent.method</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="model"/>
                <field name="method"/>
                <field name="risk_class"/>
                <field name="description"/>
                <field name="params_schema"/>
                <field name="record_arity"/>
                <field name="max_records"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="botify_field_rule_view_list" model="ir.ui.view">
        <field name="name">botify.agent.field_rule.list</field>
        <field name="model">botify.agent.field_rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="model"/>
                <field name="field"/>
                <field name="risk_class"/>
            </list>
        </field>
    </record>

    <record id="action_botify_operations" model="ir.actions.act_window">
        <field name="name">Agent operations</field>
        <field name="res_model">botify.agent.operation</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_botify_events" model="ir.actions.act_window">
        <field name="name">Agent notifications</field>
        <field name="res_model">botify.agent.event</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_botify_methods" model="ir.actions.act_window">
        <field name="name">Agent business actions</field>
        <field name="res_model">botify.agent.method</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <record id="action_botify_field_rules" model="ir.actions.act_window">
        <field name="name">Agent field risks</field>
        <field name="res_model">botify.agent.field_rule</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_botify_root" name="Botify Agent" parent="base.menu_administration" sequence="90" groups="base.group_system"/>
    <menuitem id="menu_botify_operations" name="Operations" parent="menu_botify_root" action="action_botify_operations" sequence="10"/>
    <menuitem id="menu_botify_events" name="Notifications" parent="menu_botify_root" action="action_botify_events" sequence="15"/>
    <menuitem id="menu_botify_methods" name="Business actions" parent="menu_botify_root" action="action_botify_methods" sequence="20"/>
    <menuitem id="menu_botify_field_rules" name="Field risks" parent="menu_botify_root" action="action_botify_field_rules" sequence="30"/>
</odoo>
