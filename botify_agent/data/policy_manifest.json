    "crm.lead": { "dataClass": "crm", "sensitive": false, "createOpClass": "capture_write", "writeOpClass": "normal_write", "opClasses": ["read", "capture_write", "normal_write", "lifecycle_action", "batch_action"], "sensitiveFields": ["email_from", "phone", "mobile"] },
    "sale.order": { "dataClass": "sales", "sensitive": false, "createOpClass": "normal_write", "writeOpClass": "normal_write", "opClasses": ["read", "normal_write", "lifecycle_action", "batch_action"], "sensitiveFields": [] },
