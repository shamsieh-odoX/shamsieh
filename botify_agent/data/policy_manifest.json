{
  "version": 1,
  "description": "Single source of truth for Odoo tool policy: deny-by-default model classification, method->opClass mapping, field guards and limits. Loaded verbatim (byte-identical copy) by both the TypeScript backend (packages/api/src/services/odoo/policy/manifest.ts) and the Python addon (integrations/odoo/botify_agent/models/botify_policy.py). A lockstep test on each side asserts its local copy's sha256 matches this canonical file; changing this file without updating both copies fails CI. See docs/odoo/policy.md.",
  "limits": {
    "maxResultChars": 6000,
    "maxSearchLimit": 20,
    "maxGroups": 50,
    "maxBatchSize": 25,
    "maxIds": 50,
    "maxRpcLimit": 200
  },
  "forbiddenWriteFieldPattern": "password|secret|token|api_key|oauth|totp|signup|groups_id",
  "workflowFieldPattern": "^(state|stage_id)$",
  "forbiddenMethods": ["unlink", "sudo", "with_user", "with_env", "browse", "_"],
  "methods": {
    "read": { "opClass": "read" },
    "search": { "opClass": "read" },
    "search_read": { "opClass": "read" },
    "search_count": { "opClass": "read" },
    "read_group": { "opClass": "read" },
    "formatted_read_group": { "opClass": "read" },
    "fields_get": { "opClass": "read" },
    "name_search": { "opClass": "read" },
    "name_get": { "opClass": "read" },
    "get_portal_url": { "opClass": "read" },
    "default_get": { "opClass": "read" },
    "create": { "opClass": "$modelCreateOpClass" },
    "write": { "opClass": "$modelWriteOpClass" },
    "message_post": { "opClass": "capture_write" },
    "activity_schedule": { "opClass": "capture_write" },
    "action_confirm": { "opClass": "lifecycle_action" },
    "action_done": { "opClass": "lifecycle_action" },
    "action_cancel": { "opClass": "lifecycle_action" },
    "action_draft": { "opClass": "lifecycle_action" },
    "action_lock": { "opClass": "lifecycle_action" },
    "action_unlock": { "opClass": "lifecycle_action" },
    "button_confirm": { "opClass": "lifecycle_action" },
    "button_draft": { "opClass": "lifecycle_action" },
    "button_cancel": { "opClass": "lifecycle_action" },
    "action_post": { "opClass": "lifecycle_action" },
    "action_register_payment": { "opClass": "financial_write" },
    "button_validate": { "opClass": "lifecycle_action" },
    "action_assign": { "opClass": "lifecycle_action" },
    "action_set_quantities_to_reservation": { "opClass": "lifecycle_action" },
    "action_set_won": { "opClass": "lifecycle_action" },
    "action_set_lost": { "opClass": "lifecycle_action" },
    "action_set_won_rainbowman": { "opClass": "lifecycle_action" },
    "toggle_active": { "opClass": "lifecycle_action" },
    "action_approve": { "opClass": "lifecycle_action" },
    "action_validate": { "opClass": "lifecycle_action" },
    "action_done_task": { "opClass": "lifecycle_action" },
    "action_create_payments": { "opClass": "financial_write" }
