<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_product_type_view_list" model="ir.ui.view">
        <field name="name">project.product.type.list</field>
        <field name="model">project.product.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description" optional="show"/>
                <field name="project_count" string="Projects"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="project_product_type_view_form" model="ir.ui.view">
        <field name="name">project.product.type.form</field>
        <field name="model">project.product.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_projects" type="object" class="oe_stat_button" icon="fa-folder-open">
                            <field name="project_count" widget="statinfo" string="Projects"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group>
                        <field name="description" placeholder="Optional description…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_product_type_view_search" model="ir.ui.view">
        <field name="name">project.product.type.search</field>
        <field name="model">project.product.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="project_product_type_action" model="ir.actions.act_window">
        <field name="name">Product Types</field>
        <field name="res_model">project.product.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a product type
            </p>
            <p>
                Product types classify projects (for example Software, Hardware, Consulting)
                so you can filter and group projects by type.
            </p>
        </field>
    </record>

</odoo>
