<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_task_template_view_list" model="ir.ui.view">
        <field name="name">project.task.template.list</field>
        <field name="model">project.task.template</field>
        <field name="arch" type="xml">
            <list create="1" edit="1" delete="1">
                <field name="name"/>
                <field name="stage_line_count" string="Stages"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="project_task_template_view_form" model="ir.ui.view">
        <field name="name">project.task.template.form</field>
        <field name="model">project.task.template</field>
        <field name="arch" type="xml">
            <form string="Stage Template" class="o_project_task_template_form">
                <sheet>
                    <field name="stage_line_count" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Website Delivery Workflow"/></h1>
                    </div>
                    <group>
                        <field name="active"/>
                        <field name="description" placeholder="When should this template be used?"/>
                    </group>
                    <div class="alert alert-info mb-2" role="status">
                        <strong>Build your workflow.</strong> Add as many stages as you need (To Do, In Progress, QA, Completed, …).
                        Click <em>Add a line</em> below, or use <em>Add Standard Stages</em> to start from a default set — then edit freely.
                    </div>
                    <button name="action_add_standard_stages" type="object" string="Add Standard Stages" class="btn-secondary mb-2" invisible="stage_line_count or not id"/>
                    <field name="stage_ids" context="{'default_template_id': id}">
                        <list editable="bottom" open_form_view="True" string="Stages" create="1" edit="1" delete="1">
                            <field name="template_id" column_invisible="True"/>
                            <field name="sequence" widget="handle"/>
                            <field name="name" placeholder="Stage name (e.g. In Progress)"/>
                            <field name="is_closing_stage" string="Counts as Done" widget="boolean_toggle"/>
                        </list>
                        <form string="Stage">
                            <group>
                                <field name="template_id" invisible="1"/>
                                <field name="name"/>
                                <field name="sequence"/>
                                <field name="is_closing_stage" string="Counts as Done"/>
                            </group>
                        </form>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_task_template_action" model="ir.actions.act_window">
        <field name="name">Task Templates</field>
        <field name="res_model">project.task.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a stage template</p>
            <p>Give it a name, add your stages (To Do, In Progress, Completed, …), and save. Use it when creating a new project.</p>
        </field>
    </record>

</odoo>
