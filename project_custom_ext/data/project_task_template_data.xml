<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <record id="task_template_implementation" model="project.task.template">
        <field name="name">Implementation Project Template</field>
        <field name="description">Standard ERP / system implementation workflow stages.</field>
    </record>
    <record id="task_template_impl_stage_todo" model="project.task.template.line">
        <field name="template_id" ref="task_template_implementation"/>
        <field name="sequence">10</field>
        <field name="name">To Do</field>
    </record>
    <record id="task_template_impl_stage_progress" model="project.task.template.line">
        <field name="template_id" ref="task_template_implementation"/>
        <field name="sequence">20</field>
        <field name="name">In Progress</field>
    </record>
    <record id="task_template_impl_stage_waiting" model="project.task.template.line">
        <field name="template_id" ref="task_template_implementation"/>
        <field name="sequence">30</field>
        <field name="name">Waiting</field>
    </record>
    <record id="task_template_impl_stage_review" model="project.task.template.line">
        <field name="template_id" ref="task_template_implementation"/>
        <field name="sequence">40</field>
        <field name="name">Review</field>
    </record>
    <record id="task_template_impl_stage_done" model="project.task.template.line">
        <field name="template_id" ref="task_template_implementation"/>
        <field name="sequence">50</field>
        <field name="name">Done</field>
        <field name="is_closing_stage" eval="True"/>
    </record>

    <record id="task_template_website" model="project.task.template">
        <field name="name">Website Project Template</field>
        <field name="description">Website design, development, and delivery workflow stages.</field>
    </record>
    <record id="task_template_web_stage_todo" model="project.task.template.line">
        <field name="template_id" ref="task_template_website"/>
        <field name="sequence">10</field>
        <field name="name">To Do</field>
    </record>
    <record id="task_template_web_stage_progress" model="project.task.template.line">
        <field name="template_id" ref="task_template_website"/>
        <field name="sequence">20</field>
        <field name="name">In Progress</field>
    </record>
    <record id="task_template_web_stage_waiting" model="project.task.template.line">
        <field name="template_id" ref="task_template_website"/>
        <field name="sequence">30</field>
        <field name="name">Waiting</field>
    </record>
    <record id="task_template_web_stage_review" model="project.task.template.line">
        <field name="template_id" ref="task_template_website"/>
        <field name="sequence">40</field>
        <field name="name">Review</field>
    </record>
    <record id="task_template_web_stage_done" model="project.task.template.line">
        <field name="template_id" ref="task_template_website"/>
        <field name="sequence">50</field>
        <field name="name">Done</field>
        <field name="is_closing_stage" eval="True"/>
    </record>

    <record id="task_template_crm" model="project.task.template">
        <field name="name">CRM Setup Template</field>
        <field name="description">CRM pipeline and setup workflow stages.</field>
    </record>
    <record id="task_template_crm_stage_todo" model="project.task.template.line">
        <field name="template_id" ref="task_template_crm"/>
        <field name="sequence">10</field>
        <field name="name">To Do</field>
    </record>
    <record id="task_template_crm_stage_progress" model="project.task.template.line">
        <field name="template_id" ref="task_template_crm"/>
        <field name="sequence">20</field>
        <field name="name">In Progress</field>
    </record>
    <record id="task_template_crm_stage_waiting" model="project.task.template.line">
        <field name="template_id" ref="task_template_crm"/>
        <field name="sequence">30</field>
        <field name="name">Waiting</field>
    </record>
    <record id="task_template_crm_stage_review" model="project.task.template.line">
        <field name="template_id" ref="task_template_crm"/>
        <field name="sequence">40</field>
        <field name="name">Review</field>
    </record>
    <record id="task_template_crm_stage_done" model="project.task.template.line">
        <field name="template_id" ref="task_template_crm"/>
        <field name="sequence">50</field>
        <field name="name">Done</field>
        <field name="is_closing_stage" eval="True"/>
    </record>

</odoo>
