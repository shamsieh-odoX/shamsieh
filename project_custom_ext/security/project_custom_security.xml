<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_project_edit_only" model="res.groups">
        <field name="name">Project Edit Only</field>
        <field name="comment">Can edit projects and tasks but cannot create projects or move task stages.</field>
        <field name="sequence">11</field>
        <field name="privilege_id" ref="project.res_groups_privilege_project"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user')), (4, ref('hr_timesheet.group_hr_timesheet_user'))]"/>
    </record>

    <record id="group_project_create_move" model="res.groups">
        <field name="name">Project Create/Move</field>
        <field name="comment">Can create projects and move tasks between stages.</field>
        <field name="sequence">12</field>
        <field name="privilege_id" ref="project.res_groups_privilege_project"/>
        <field name="implied_ids" eval="[(4, ref('group_project_edit_only'))]"/>
    </record>

    <record id="group_project_custom_manager" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="comment">Full project management: create, edit, delete tasks, reports, and configuration.</field>
        <field name="sequence">15</field>
        <field name="privilege_id" ref="project.res_groups_privilege_project"/>
        <field name="implied_ids" eval="[(4, ref('group_project_create_move'))]"/>
    </record>

    <data noupdate="1">
        <!-- Edit Only: write access documented; stage_id blocked in Python on project.task -->
        <record id="project_task_edit_only_no_stage_rule" model="ir.rule">
            <field name="name">Project Task: Edit Only users (write access)</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_project_edit_only'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="project_project_create_move_rule" model="ir.rule">
            <field name="name">Project: Create/Move can create projects</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_project_create_move'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
