<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_overtime">
        <field name="name">Overtime</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_overtime_user" model="res.groups">
        <field name="name">User: Own Overtime Requests</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_overtime"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Employees can create and submit their own overtime requests.</field>
    </record>

    <record id="group_overtime_hr_officer" model="res.groups">
        <field name="name">Officer: Overtime HR Approval</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_overtime"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user')), (4, ref('group_overtime_user'))]"/>
        <field name="comment">HR officers perform final overtime approval and can see all requests.</field>
    </record>

    <record id="group_overtime_admin" model="res.groups">
        <field name="name">Administrator: Overtime Configuration</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_overtime"/>
        <field name="implied_ids" eval="[(4, ref('group_overtime_hr_officer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to overtime types, settings, and all requests.</field>
    </record>

    <!-- Every internal user can request overtime (same pattern as Time Off). -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_overtime_user'))]"/>
    </record>

    <data noupdate="1">

        <!-- Employee: own records, read always; write only in draft -->
        <record id="hr_overtime_request_rule_employee_read" model="ir.rule">
            <field name="name">Overtime Request: employee read own</field>
            <field name="model_id" ref="model_hr_overtime_request"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_overtime_request_rule_employee_write_draft" model="ir.rule">
            <field name="name">Overtime Request: employee write draft</field>
            <field name="model_id" ref="model_hr_overtime_request"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id), ('state', '=', 'draft')]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="hr_overtime_request_rule_employee_cancel" model="ir.rule">
            <field name="name">Overtime Request: employee cancel submitted</field>
            <field name="model_id" ref="model_hr_overtime_request"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id), ('state', '=', 'submitted')]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_overtime_request_rule_employee_reset" model="ir.rule">
            <field name="name">Overtime Request: employee reset refused/cancelled</field>
            <field name="model_id" ref="model_hr_overtime_request"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id), ('state', 'in', ('cancel', 'refused'))]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager: requests currently pending on them -->
        <record id="hr_overtime_request_rule_manager" model="ir.rule">
            <field name="name">Overtime Request: current approver</field>
            <field name="model_id" ref="model_hr_overtime_request"/>
            <field name="domain_force">['|',
                ('current_approver_id', '=', user.id),
                '&amp;', ('approval_line_ids.approver_id', '=', user.id), ('approval_line_ids.state', '=', 'to_approve')
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- HR officer: read all; write when HR stage is active -->
        <record id="hr_overtime_request_rule_hr_read" model="ir.rule">
            <field name="name">Overtime Request: HR officer read all</field>
            <field name="model_id" ref="model_hr_overtime_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_overtime_hr_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_overtime_request_rule_hr_write" model="ir.rule">
            <field name="name">Overtime Request: HR officer write at HR stage</field>
            <field name="model_id" ref="model_hr_overtime_request"/>
            <field name="domain_force">[
                ('approval_line_ids.role', '=', 'hr'),
                ('approval_line_ids.state', '=', 'to_approve'),
            ]</field>
            <field name="groups" eval="[(4, ref('group_overtime_hr_officer'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Admin: unrestricted -->
        <record id="hr_overtime_request_rule_admin" model="ir.rule">
            <field name="name">Overtime Request: administrator full access</field>
            <field name="model_id" ref="model_hr_overtime_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_overtime_admin'))]"/>
        </record>

        <!-- Multi-company -->
        <record id="hr_overtime_request_comp_rule" model="ir.rule">
            <field name="name">Overtime Request: multi-company</field>
            <field name="model_id" ref="model_hr_overtime_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_overtime_type_comp_rule" model="ir.rule">
            <field name="name">Overtime Type: multi-company</field>
            <field name="model_id" ref="model_hr_overtime_type"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
