<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_overtime_type_view_list" model="ir.ui.view">
        <field name="name">hr.overtime.type.list</field>
        <field name="model">hr.overtime.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="company_id"/>
                <field name="category"/>
                <field name="name"/>
                <field name="rate_multiplier"/>
                <field name="code" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="hr_overtime_type_view_form" model="ir.ui.view">
        <field name="name">hr.overtime.type.form</field>
        <field name="model">hr.overtime.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Regular Overtime"/></h1>
                    </div>
                    <group>
                        <group string="Category &amp; Rate">
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="category"/>
                            <field name="rate_multiplier"/>
                        </group>
                        <group string="Technical">
                            <field name="code" readonly="1"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Each company branch needs one active type per category (Regular, Weekend, Day Off).
                        Change the <strong>Rate Multiplier</strong> here — overtime requests pick the type automatically from the date.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_overtime_type_view_search" model="ir.ui.view">
        <field name="name">hr.overtime.type.search</field>
        <field name="model">hr.overtime.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <field name="category"/>
                <field name="code"/>
                <filter string="Regular" name="regular" domain="[('category', '=', 'regular')]"/>
                <filter string="Weekend" name="weekend" domain="[('category', '=', 'weekend')]"/>
                <filter string="Day Off" name="day_off" domain="[('category', '=', 'day_off')]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_overtime_type" model="ir.actions.act_window">
        <field name="name">Overtime Types</field>
        <field name="res_model">hr.overtime.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_company': 1}</field>
    </record>

</odoo>
