<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_loan_refuse_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.loan.refuse.wizard.form</field>
        <field name="model">hr.loan.refuse.wizard</field>
        <field name="arch" type="xml">
            <form string="Refuse Loan">
                <group>
                    <field name="loan_id" invisible="1"/>
                    <field name="approval_line_id" invisible="1"/>
                    <field name="reason" placeholder="Reason for refusal..."/>
                </group>
                <footer>
                    <button name="action_refuse" string="Refuse" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
