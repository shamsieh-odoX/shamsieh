<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_loans_advances">
        <field name="name">Loans &amp; Advances</field>
        <field name="sequence">16</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_loans_advances_user" model="res.groups">
        <field name="name">User: Own Loans &amp; Advances</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_loans_advances"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Employees can create and submit their own advance and loan requests.</field>
    </record>

    <record id="group_loans_advances_hr_officer" model="res.groups">
        <field name="name">Officer: Loans &amp; Advances HR Approval</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_loans_advances"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user')), (4, ref('group_loans_advances_user'))]"/>
        <field name="comment">HR officers perform final approval and can see all records.</field>
    </record>

    <record id="group_loans_advances_admin" model="res.groups">
        <field name="name">Administrator: Loans &amp; Advances</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_loans_advances"/>
        <field name="implied_ids" eval="[(4, ref('group_loans_advances_hr_officer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to all loans and advances.</field>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_loans_advances_user'))]"/>
    </record>

    <data noupdate="1">

        <!-- Advance: employee read own -->
        <record id="hr_employee_advance_rule_employee_read" model="ir.rule">
            <field name="name">Advance: employee read own</field>
            <field name="model_id" ref="model_hr_employee_advance"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_employee_advance_rule_employee_write_draft" model="ir.rule">
            <field name="name">Advance: employee write draft</field>
            <field name="model_id" ref="model_hr_employee_advance"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id), ('state', '=', 'draft')]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="hr_employee_advance_rule_employee_cancel" model="ir.rule">
            <field name="name">Advance: employee cancel submitted</field>
            <field name="model_id" ref="model_hr_employee_advance"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id), ('state', 'in', ('draft', 'submitted'))]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_employee_advance_rule_employee_reset" model="ir.rule">
            <field name="name">Advance: employee reset refused/cancelled</field>
            <field name="model_id" ref="model_hr_employee_advance"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id), ('state', 'in', ('cancel', 'refused'))]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_employee_advance_rule_manager" model="ir.rule">
            <field name="name">Advance: manager team or current approver</field>
            <field name="model_id" ref="model_hr_employee_advance"/>
            <field name="domain_force">['|', '|',
                ('employee_id.parent_id.user_id', '=', user.id),
                ('current_approver_id', '=', user.id),
                '&amp;', ('approval_line_ids.approver_id', '=', user.id), ('approval_line_ids.state', '=', 'to_approve')
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_employee_advance_rule_hr_read" model="ir.rule">
            <field name="name">Advance: HR officer read all</field>
            <field name="model_id" ref="model_hr_employee_advance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_loans_advances_hr_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_employee_advance_rule_hr_write" model="ir.rule">
            <field name="name">Advance: HR officer write at HR stage</field>
            <field name="model_id" ref="model_hr_employee_advance"/>
            <field name="domain_force">[
                ('approval_line_ids.role', '=', 'hr'),
                ('approval_line_ids.state', '=', 'to_approve'),
            ]</field>
            <field name="groups" eval="[(4, ref('group_loans_advances_hr_officer'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_employee_advance_rule_admin" model="ir.rule">
            <field name="name">Advance: administrator full access</field>
            <field name="model_id" ref="model_hr_employee_advance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_loans_advances_admin'))]"/>
        </record>

        <record id="hr_employee_advance_comp_rule" model="ir.rule">
            <field name="name">Advance: multi-company</field>
            <field name="model_id" ref="model_hr_employee_advance"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('employee_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Loan: employee read own -->
        <record id="hr_employee_loan_rule_employee_read" model="ir.rule">
            <field name="name">Loan: employee read own</field>
            <field name="model_id" ref="model_hr_employee_loan"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_employee_loan_rule_employee_write_draft" model="ir.rule">
            <field name="name">Loan: employee write draft</field>
            <field name="model_id" ref="model_hr_employee_loan"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id), ('state', '=', 'draft')]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="hr_employee_loan_rule_employee_cancel" model="ir.rule">
            <field name="name">Loan: employee cancel submitted</field>
            <field name="model_id" ref="model_hr_employee_loan"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id), ('state', 'in', ('draft', 'submitted'))]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_employee_loan_rule_employee_reset" model="ir.rule">
            <field name="name">Loan: employee reset refused/cancelled</field>
            <field name="model_id" ref="model_hr_employee_loan"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id), ('state', 'in', ('cancel', 'refused'))]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_employee_loan_rule_manager" model="ir.rule">
            <field name="name">Loan: manager team or current approver</field>
            <field name="model_id" ref="model_hr_employee_loan"/>
            <field name="domain_force">['|', '|',
                ('employee_id.parent_id.user_id', '=', user.id),
                ('current_approver_id', '=', user.id),
                '&amp;', ('approval_line_ids.approver_id', '=', user.id), ('approval_line_ids.state', '=', 'to_approve')
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_employee_loan_rule_hr_read" model="ir.rule">
            <field name="name">Loan: HR officer read all</field>
            <field name="model_id" ref="model_hr_employee_loan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_loans_advances_hr_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_employee_loan_rule_hr_write" model="ir.rule">
            <field name="name">Loan: HR officer write at HR stage</field>
            <field name="model_id" ref="model_hr_employee_loan"/>
            <field name="domain_force">[
                ('approval_line_ids.role', '=', 'hr'),
                ('approval_line_ids.state', '=', 'to_approve'),
            ]</field>
            <field name="groups" eval="[(4, ref('group_loans_advances_hr_officer'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_employee_loan_rule_admin" model="ir.rule">
            <field name="name">Loan: administrator full access</field>
            <field name="model_id" ref="model_hr_employee_loan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_loans_advances_admin'))]"/>
        </record>

        <record id="hr_employee_loan_comp_rule" model="ir.rule">
            <field name="name">Loan: multi-company</field>
            <field name="model_id" ref="model_hr_employee_loan"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('employee_id.user_id', '=', user.id)]</field>
        </record>

    </data>
</odoo>
