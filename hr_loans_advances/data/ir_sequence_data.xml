<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_hr_employee_advance" model="ir.sequence">
        <field name="name">Employee Advance</field>
        <field name="code">hr.employee.advance</field>
        <field name="prefix">ADV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_hr_employee_loan" model="ir.sequence">
        <field name="name">Employee Loan</field>
        <field name="code">hr.employee.loan</field>
        <field name="prefix">LOAN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
