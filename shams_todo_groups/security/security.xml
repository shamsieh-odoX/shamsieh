<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_shams_todo">
        <field name="name">Shams To-Do</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_todo_user" model="res.groups">
        <field name="name">User: To-Do Member</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_shams_todo"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Access tasks in groups where the user is a member.</field>
    </record>

    <record id="group_todo_manager" model="res.groups">
        <field name="name">Manager: To-Do Group Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_shams_todo"/>
        <field name="implied_ids" eval="[(4, ref('group_todo_user'))]"/>
        <field name="comment">Create groups and manage tasks and members for assigned groups.</field>
    </record>

    <record id="group_todo_management" model="res.groups">
        <field name="name">Management: To-Do Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_shams_todo"/>
        <field name="implied_ids" eval="[(4, ref('group_todo_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to all To-Do groups and tasks.</field>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_todo_user'))]"/>
    </record>

</odoo>
