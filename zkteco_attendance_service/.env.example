# ZKTeco attendance bridge — copy to .env and fill in values
ODOO_URL=https://shamsieh.odoo.com
ODOO_DB=your_database_name
ODOO_BOT_USER=m.saqer@shamsieh.com
ODOO_API_KEY=your_api_key_from_odoo_preferences

# fingerprint.device database id for the ZKTeco device record
ZKTECO_DEVICE_ID=2

# Direct device access (office LAN)
ZKTECO_IP=192.178.1.40
ZKTECO_PORT=4370
ZKTECO_PASSWORD=0
ZKTECO_FORCE_UDP=false
ZKTECO_TIMEZONE=Asia/Amman

# How often to poll (seconds) and how far back to fetch on each cycle
POLL_INTERVAL_SECONDS=60
LOOKBACK_HOURS=24
VERBOSE_LOGGING=true
