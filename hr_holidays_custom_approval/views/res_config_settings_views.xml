<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_custom_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.custom.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='work_organization_setting_container']" position="after">
                <block title="Custom Time Off Approval" name="custom_time_off_approval_setting_container">
                    <setting string="Time Off General Manager" company_dependent="1"
                             help="Second approver when the employee has no org-chart manager (parent_id). Must be linked to a user.">
                        <field name="time_off_gm_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
