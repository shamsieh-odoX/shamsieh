# ZKTeco ADMS bridge — copy to .env and fill in values
# Keep Hikvision bridge .env separate (scripts/hikvision_attendance_service/.env).

ODOO_URL=https://shamsieh.odoo.com
ODOO_DB=shamsieh-odox-shamsieh-production-33677101
ODOO_BOT_USER=m.saqer@shamsieh.com
ODOO_API_KEY=your_api_key_from_odoo_preferences

# fingerprint.device database id for the ZKTeco device record (not the Hikvision one)
ZKTECO_DEVICE_ID=2
ZKTECO_SERIAL=SRN5244400238
ZKTECO_TIMEZONE=Asia/Amman

# Local ADMS HTTP listener (device Cloud Server URL → http://<this-pc-ip>:8088/iclock/)
ADMS_LISTEN_HOST=0.0.0.0
ADMS_LISTEN_PORT=8088

# Optional LAN pull diagnostics (usually leave false — use ADMS push instead)
ENABLE_POLL=false
ZKTECO_IP=192.168.1.40
ZKTECO_PORT=4370
ZKTECO_PASSWORD=3
ZKTECO_FORCE_UDP=false
POLL_INTERVAL_SECONDS=60
LOOKBACK_HOURS=24
VERBOSE_LOGGING=true
