# ZKTeco poll bridge — copy to .env and fill values.
# Keep Hikvision bridge .env separate.

ODOO_URL=https://shamsieh.odoo.com
ODOO_DB=shamsieh-odox-shamsieh-production-33677101
ODOO_BOT_USER=m.saqer@shamsieh.com
ODOO_API_KEY=your_api_key_from_odoo_preferences

ZKTECO_DEVICE_ID=2
ZKTECO_SERIAL=SRN5244400238
ZKTECO_TIMEZONE=Asia/Amman

# F28: use poll (port 4370). Close Attendance Management while running.
ENABLE_POLL=true
ENABLE_ADMS=false
POLL_INTERVAL_SECONDS=30
LOOKBACK_HOURS=24

ZKTECO_IP=192.168.1.40
ZKTECO_PORT=4370
ZKTECO_PASSWORD=0
ZKTECO_FORCE_UDP=false
ZKTECO_TIMEOUT=15

ADMS_LISTEN_HOST=0.0.0.0
ADMS_LISTEN_PORT=8088
VERBOSE_LOGGING=true
