<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_team_view_form_custom" model="ir.ui.view">
        <field name="name">crm.team.form.custom</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='left']" position="inside">
                <field name="country_id" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Targets" name="targets">
                        <field name="target_ids">
                            <list editable="bottom">
                                <field name="period"/>
                                <field name="currency_id"/>
                                <field name="target_amount"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="actual_won_revenue"/>
                                <field name="expected_revenue_total"/>
                                <field name="achievement_pct"/>
                                <field name="remaining_target"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="crm_team_view_search_custom" model="ir.ui.view">
        <field name="name">crm.team.search.custom</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="country_id"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Country" name="group_country" context="{'group_by': 'country_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
