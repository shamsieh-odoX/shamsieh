<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_sector_view_list" model="ir.ui.view">
        <field name="name">crm.lead.sector.list</field>
        <field name="model">crm.lead.sector</field>
        <field name="arch" type="xml">
            <list string="Sectors" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
                <field name="lead_count"/>
            </list>
        </field>
    </record>

    <record id="crm_lead_sector_view_form" model="ir.ui.view">
        <field name="name">crm.lead.sector.form</field>
        <field name="model">crm.lead.sector</field>
        <field name="arch" type="xml">
            <form string="Sector">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="lead_count"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="crm_lead_sector_view_search" model="ir.ui.view">
        <field name="name">crm.lead.sector.search</field>
        <field name="model">crm.lead.sector</field>
        <field name="arch" type="xml">
            <search string="Sectors">
                <field name="name"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="crm_lead_sector_action" model="ir.actions.act_window">
        <field name="name">Sectors</field>
        <field name="res_model">crm.lead.sector</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="crm_lead_sector_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a sector for classifying leads.
            </p>
            <p>
                Sectors appear on lead forms and can be used in filters and reports.
            </p>
        </field>
    </record>

</odoo>
