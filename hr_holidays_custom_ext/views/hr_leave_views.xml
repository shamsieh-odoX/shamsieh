<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Expose can_second_approve for optional UI; standard Validate uses can_validate. -->
    <record id="hr_leave_view_form_second_approval" model="ir.ui.view">
        <field name="name">hr.leave.form.second.approval</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="can_second_approve" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="is_hourly_departure_type" invisible="1"/>
                <field name="departure_reason"
                         invisible="not is_hourly_departure_type"
                         required="is_hourly_departure_type"
                         placeholder="Special reason for this departure"/>
                <field name="is_hourly_departure_conversion" invisible="1"/>
                <field name="hourly_departure_hours_applied" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="hr_leave_type_view_form_hourly_departure" model="ir.ui.view">
        <field name="name">hr.leave.type.form.hourly.departure</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='request_unit']" position="after">
                <field name="is_hourly_departure"/>
            </xpath>
        </field>
    </record>
</odoo>
