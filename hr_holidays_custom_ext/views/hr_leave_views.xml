<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Expose can_second_approve for optional UI; standard Validate uses can_validate. -->
    <record id="hr_leave_view_form_second_approval" model="ir.ui.view">
        <field name="name">hr.leave.form.second.approval</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="can_second_approve" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
