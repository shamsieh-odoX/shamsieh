<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ensure GM / second approver always sees an Approve action at validate1 -->
    <record id="hr_leave_view_form_second_approval" model="ir.ui.view">
        <field name="name">hr.leave.form.second.approval</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_approve"
                        type="object"
                        string="Approve"
                        class="oe_highlight"
                        invisible="state != 'validate1' or not can_validate"/>
            </xpath>
        </field>
    </record>

    <record id="hr_leave_view_form_manager_second_approval" model="ir.ui.view">
        <field name="name">hr.leave.form.manager.second.approval</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_approve"
                        type="object"
                        string="Approve"
                        class="oe_highlight"
                        invisible="state != 'validate1' or not can_validate"/>
            </xpath>
        </field>
    </record>

    <record id="hr_leave_view_form_dashboard_manager_second_approval" model="ir.ui.view">
        <field name="name">hr.leave.form.dashboard.manager.second.approval</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_dashboard_manager_new_time_off"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_approve"
                        type="object"
                        string="Approve"
                        class="oe_highlight"
                        invisible="state != 'validate1' or not can_validate"/>
            </xpath>
        </field>
    </record>
</odoo>
