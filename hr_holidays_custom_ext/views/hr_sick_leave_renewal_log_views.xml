<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_sick_leave_renewal_log_tree" model="ir.ui.view">
        <field name="name">hr.sick.leave.renewal.log.list</field>
        <field name="model">hr.sick.leave.renewal.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="run_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="renewal_year"/>
                <field name="trigger"/>
                <field name="employees_processed"/>
                <field name="allocations_created"/>
                <field name="allocations_skipped"/>
                <field name="summary"/>
            </list>
        </field>
    </record>

    <record id="view_hr_sick_leave_renewal_log_form" model="ir.ui.view">
        <field name="name">hr.sick.leave.renewal.log.form</field>
        <field name="model">hr.sick.leave.renewal.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="run_date" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="renewal_year" readonly="1"/>
                            <field name="trigger" readonly="1"/>
                        </group>
                        <group>
                            <field name="employees_processed" readonly="1"/>
                            <field name="allocations_created" readonly="1"/>
                            <field name="allocations_skipped" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="summary" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_sick_leave_renewal_log_search" model="ir.ui.view">
        <field name="name">hr.sick.leave.renewal.log.search</field>
        <field name="model">hr.sick.leave.renewal.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="renewal_year"/>
                <field name="trigger"/>
                <filter string="Scheduled" name="filter_cron" domain="[('trigger', '=', 'cron')]"/>
                <filter string="Manual" name="filter_manual" domain="[('trigger', '=', 'manual')]"/>
                <group>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Year" name="group_year" context="{'group_by': 'renewal_year'}"/>
                    <filter string="Trigger" name="group_trigger" context="{'group_by': 'trigger'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_sick_leave_renewal_log" model="ir.actions.act_window">
        <field name="name">Sick Leave Renewal Log</field>
        <field name="res_model">hr.sick.leave.renewal.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
</odoo>
