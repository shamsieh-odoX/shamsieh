<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_overtime_request_view_form_timeoff_info" model="ir.ui.view">
        <field name="name">hr.overtime.request.form.timeoff.info</field>
        <field name="model">hr.overtime.request</field>
        <field name="inherit_id" ref="hr_overtime_management.hr_overtime_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="alert alert-info" role="alert" invisible="state != 'hr_approved'">
                    Approved overtime hours have been added to your
                    <strong>Overtime</strong> Time Off balance.
                    Use them to leave early on another day by requesting Overtime in Time Off.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
