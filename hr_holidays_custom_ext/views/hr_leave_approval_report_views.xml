<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_approval_log_search" model="ir.ui.view">
        <field name="name">hr.leave.approval.log.search</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <search string="Leave Approval Log">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="holiday_status_id"/>
                <filter string="To Approve" name="to_approve" domain="[('state', '=', 'confirm')]"/>
                <filter string="Second Approval" name="second_approval" domain="[('state', '=', 'validate1')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'validate')]"/>
                <filter string="Refused" name="refused" domain="[('state', '=', 'refuse')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter string="Start Date" name="date_from_filter" date="date_from"/>
                <filter string="End Date" name="date_to_filter" date="date_to"/>
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Leave Type" name="group_leave_type" context="{'group_by': 'holiday_status_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_leave_approval_log_list" model="ir.ui.view">
        <field name="name">hr.leave.approval.log.list</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <list string="Leave Approval Log" create="0">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="department_id" optional="show"/>
                <field name="holiday_status_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="duration_display"/>
                <field name="state" widget="badge"
                    decoration-warning="state in ('confirm','validate1')"
                    decoration-success="state == 'validate'"
                    decoration-danger="state == 'refuse'"/>
                <field name="first_approver_id" optional="show"/>
                <field name="second_approver_id" optional="hide"/>
                <field name="refuse_reason" optional="hide"/>
                <field name="approval_trail_count" string="Trail Steps" optional="show"/>
            </list>
        </field>
    </record>

    <record id="hr_leave_approval_log_form" model="ir.ui.view">
        <field name="name">hr.leave.approval.log.form</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <form string="Leave Approval Log" create="0" edit="0" delete="0">
                <header>
                    <button name="action_print_approval_report" string="Print" type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="employee_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="department_id" readonly="1"/>
                            <field name="holiday_status_id" readonly="1"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                        <group>
                            <field name="duration_display" readonly="1"/>
                            <field name="first_approver_id" readonly="1"/>
                            <field name="second_approver_id" readonly="1"/>
                            <field name="refuse_reason" readonly="1" invisible="not refuse_reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approval Trail" name="approval_trail">
                            <field name="approval_trail_ids" readonly="1">
                                <list>
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="stage"/>
                                    <field name="approver_id"/>
                                    <field name="state"/>
                                    <field name="decision_date"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_leave_approval_log" model="ir.actions.act_window">
        <field name="name">Leave Approval Log</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'draft')]</field>
        <field name="search_view_id" ref="hr_leave_approval_log_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('hr_leave_approval_log_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hr_leave_approval_log_form')}),
        ]"/>
        <field name="context">{'search_default_group_state': 0}</field>
    </record>

    <record id="hr_leave_view_form_approval_trail" model="ir.ui.view">
        <field name="name">hr.leave.view.form.approval.trail</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
                    <xpath expr="//header" position="inside">
                <button name="action_print_approval_report" string="Print Approval Log" type="object"
                    invisible="not id"/>
            </xpath>
            <!-- Own requests: Approve/Refuse stay hidden via can_approve/can_refuse/can_validate. -->
            <xpath expr="//sheet/div[hasclass('o_hr_leave_content')]" position="after">
                <field name="approval_trail_count" invisible="1"/>
                <notebook invisible="approval_trail_count == 0">
                    <page string="Approval Trail" name="approval_trail">
                        <field name="refuse_reason" readonly="1" invisible="not refuse_reason"/>
                        <field name="approval_trail_ids" readonly="1">
                            <list>
                                <field name="sequence" column_invisible="1"/>
                                <field name="stage"/>
                                <field name="approver_id"/>
                                <field name="state"/>
                                <field name="decision_date"/>
                                <field name="comment"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

</odoo>
