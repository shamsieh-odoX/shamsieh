<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_refuse_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.leave.refuse.wizard.form</field>
        <field name="model">hr.leave.refuse.wizard</field>
        <field name="arch" type="xml">
            <form string="Refuse Time Off">
                <group>
                    <field name="leave_id" readonly="1"/>
                    <field name="reason" placeholder="Enter the refusal reason..."/>
                </group>
                <footer>
                    <button name="action_refuse" string="Refuse" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
