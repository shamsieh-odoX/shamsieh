<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_sick_leave_renewal_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.sick.leave.renewal.wizard.form</field>
        <field name="model">hr.sick.leave.renewal.wizard</field>
        <field name="arch" type="xml">
            <form string="Run Sick Leave Renewal">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="renewal_year"/>
                </group>
                <footer>
                    <button name="action_run_renewal" string="Run Renewal" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
