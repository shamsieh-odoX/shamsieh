<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_payslip_breakdown" model="report.paperformat">
        <field name="name">Payslip Breakdown</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_payslip_breakdown" model="ir.actions.report">
        <field name="name">Payslip Breakdown</field>
        <field name="model">hr.payslip.breakdown.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_payroll_custom_ext.report_payslip_breakdown</field>
        <field name="report_file">hr_payroll_custom_ext.report_payslip_breakdown</field>
        <field name="print_report_name">'Payslip Breakdown - %s to %s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_payslip_breakdown"/>
    </record>

    <template id="report_payslip_breakdown">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Payslip Breakdown Report</h2>
                    <p class="text-center mb-4">
                        Period: <strong><t t-esc="header['date_from']"/></strong>
                        to <strong><t t-esc="header['date_to']"/></strong>
                        <br/>
                        Department: <strong><t t-esc="header['department']"/></strong>
                    </p>
                    <t t-if="not employees_data">
                        <p class="text-muted">No payslips found for the selected filters.</p>
                    </t>
                    <t t-foreach="employees_data" t-as="row">
                        <div class="mt-4" style="page-break-inside: avoid;">
                            <h4>
                                <t t-esc="row['employee'].name"/>
                                <span class="text-muted" t-if="row['department']">
                                    — <t t-esc="row['department'].name"/>
                                </span>
                            </h4>
                            <div class="row">
                                <div class="col-6">
                                    <strong>Payslip:</strong>
                                    <span t-esc="row['payslip'].number or row['payslip'].name"/>
                                    <br/>
                                    <strong>Period:</strong>
                                    <span t-field="row['payslip'].date_from"/> -
                                    <span t-field="row['payslip'].date_to"/>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-6">
                                    <h5>Earnings</h5>
                                    <table class="table table-sm o_main_table">
                                        <tbody>
                                            <t t-foreach="earning_keys" t-as="bucket_key">
                                                <tr t-if="row['buckets'][bucket_key]">
                                                    <td><t t-esc="row['bucket_labels'][bucket_key]"/></td>
                                                    <td class="text-end">
                                                        <span t-esc="row['buckets'][bucket_key]"
                                                            t-options="{'widget': 'monetary', 'display_currency': row['payslip'].currency_id}"/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <tr t-if="row['other_earnings']">
                                                <td>Other Earnings</td>
                                                <td class="text-end">
                                                    <span t-esc="row['other_earnings']"
                                                        t-options="{'widget': 'monetary', 'display_currency': row['payslip'].currency_id}"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td><strong>Gross</strong></td>
                                                <td class="text-end">
                                                    <strong>
                                                        <span t-esc="row['gross']"
                                                            t-options="{'widget': 'monetary', 'display_currency': row['payslip'].currency_id}"/>
                                                    </strong>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col-6">
                                    <h5>Deductions</h5>
                                    <table class="table table-sm o_main_table">
                                        <tbody>
                                            <t t-foreach="deduction_keys" t-as="bucket_key">
                                                <tr t-if="row['buckets'][bucket_key]">
                                                    <td><t t-esc="row['bucket_labels'][bucket_key]"/></td>
                                                    <td class="text-end">
                                                        <span t-esc="row['buckets'][bucket_key]"
                                                            t-options="{'widget': 'monetary', 'display_currency': row['payslip'].currency_id}"/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <tr t-if="row['other_deductions']">
                                                <td>Other Deductions</td>
                                                <td class="text-end">
                                                    <span t-esc="row['other_deductions']"
                                                        t-options="{'widget': 'monetary', 'display_currency': row['payslip'].currency_id}"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td><strong>Total Deductions</strong></td>
                                                <td class="text-end">
                                                    <strong>
                                                        <span t-esc="row['total_deductions']"
                                                            t-options="{'widget': 'monetary', 'display_currency': row['payslip'].currency_id}"/>
                                                    </strong>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <table class="table table-sm o_main_table mt-2">
                                <tbody>
                                    <tr>
                                        <td><strong>Net Pay</strong></td>
                                        <td class="text-end">
                                            <strong>
                                                <span t-esc="row['buckets']['net']"
                                                    t-options="{'widget': 'monetary', 'display_currency': row['payslip'].currency_id}"/>
                                            </strong>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>

</odoo>
