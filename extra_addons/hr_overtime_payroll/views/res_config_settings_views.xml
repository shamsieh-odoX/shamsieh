<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_overtime_payroll" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.overtime.payroll</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_overtime_management.res_config_settings_view_form_overtime"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='overtime_payroll_setting']" position="after">
                <setting string="Push Overtime to Payslips" help="Create or update a payslip input line when overtime is fully approved."
                    invisible="not module_hr_overtime_payroll">
                    <field name="overtime_link_to_payroll"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
