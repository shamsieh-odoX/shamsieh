<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_payslip_view_form_jo_custom" model="ir.ui.view">
        <field name="name">hr.payslip.form.jo.custom</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='account_info']" position="after">
                <group string="Jordan Payroll Details" name="jo_payroll_details">
                    <field name="jo_absence_days"/>
                    <field name="jo_unpaid_leave_days"/>
                    <field name="jo_overtime_amount"/>
                    <field name="jo_loan_installment"/>
                    <field name="jo_advance_deduction"/>
                    <field name="jo_deductions_posted" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
