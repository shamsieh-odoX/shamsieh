<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_jo_payroll_custom" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.jo.payroll.custom</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_payroll']" position="inside">
                <block title="Jordan Custom Payroll" name="jo_payroll_custom_setting_container">
                    <setting string="Daily Wage Divisor" company_dependent="1"
                             help="Daily rate = monthly wage divided by this value (Jordan standard: 30).">
                        <field name="payroll_daily_wage_divisor" class="text-center" style="width: 5ch;"/>
                    </setting>
                    <setting string="Absence Deductions" company_dependent="1"
                             help="Deduct absent working days from payslips based on daily attendance status.">
                        <field name="payroll_absence_deduction_enabled"/>
                    </setting>
                    <setting string="Jordan Rule Parameters"
                             help="Edit SSC rates, tax brackets, and other Jordan payroll parameters.">
                        <button name="action_open_jordan_rule_parameters"
                                type="object"
                                string="Open Rule Parameters"
                                class="btn-link"
                                icon="oi-arrow-right"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
