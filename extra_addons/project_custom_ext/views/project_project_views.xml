<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_project_form_custom" model="ir.ui.view">
        <field name="name">project.project.form.custom</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="template_applied" invisible="1"/>
            </xpath>
            <xpath expr="//div[@class='oe_title']" position="after">
                <div class="o_project_progress_card">
                    <div class="o_project_progress_card_header">
                        <span class="o_project_progress_card_title">Project Progress</span>
                        <span class="o_project_progress_card_badge">
                            <field name="progress_percentage" nolabel="1" readonly="1" class="oe_inline"/>%
                        </span>
                    </div>
                    <field name="progress_percentage" widget="progressbar" nolabel="1" readonly="1" options="{'editable': false}"/>
                    <field name="progress_range" invisible="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="task_template_id" string="Task Template" readonly="template_applied" invisible="is_template" options="{'no_create': True}"/>
                <field name="stage_id" string="Project Stage" groups="project.group_project_stages"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="country_id" options="{'no_create': True}"/>
                <field name="sales_team_id" string="Sales Team"/>
            </xpath>
            <xpath expr="//field[@name='date']" position="after">
                <field name="estimated_hours" widget="compact_hours" readonly="1"/>
                <field name="spent_hours" widget="compact_hours" readonly="1"/>
                <field name="remaining_hours" widget="compact_hours" readonly="1"/>
            </xpath>
            <xpath expr="//page[@name='settings']//group[@name='extra_settings']" position="inside">
                <field name="allocated_datetime" widget="datetime"/>
                <field name="time_remaining_datetime" widget="datetime" readonly="1"/>
            </xpath>
            <xpath expr="//page[@name='description']" position="after">
                <page string="Task Stages" name="project_task_stages" invisible="is_template">
                    <div class="alert alert-secondary mb-2" role="status">
                        Add, rename, or reorder the columns on this project's task board (To Do, In Progress, Completed, …).
                        Use <strong>Counts as Done</strong> on the final stage so completed tasks update project progress.
                    </div>
                    <field name="type_ids" context="{'default_project_ids': [(4, id)]}">
                        <list editable="bottom" open_form_view="True" string="Task Stages">
                            <field name="sequence" widget="handle"/>
                            <field name="name" placeholder="e.g. To Do"/>
                            <field name="fold" string="Folded in Kanban" optional="show"/>
                            <field name="is_closing_stage" string="Counts as Done"/>
                            <field name="color" widget="color_picker" optional="hide"/>
                            <field name="project_ids" column_invisible="True"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="project_project_create_form_custom" model="ir.ui.view">
        <field name="name">project.project.create.form.custom</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.project_project_view_form_simplified_footer"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title mb-lg-3 mb-md-2']" position="after">
                <div class="o_project_create_custom">
                    <group>
                        <group string="Location &amp; Team">
                            <field name="country_id" placeholder="Select country" options="{'no_create': True, 'no_open': True}"/>
                            <field name="sales_team_id" string="Sales Team" placeholder="Optional"/>
                        </group>
                        <group string="Workflow Template">
                            <field name="task_template_id" string="Task Template" placeholder="Choose a workflow template…" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <div class="alert alert-info mb-0" role="status" invisible="not task_template_id">
                        <strong>Stages only.</strong> The template will set up columns like To Do and In Progress. You add your own tasks afterward.
                    </div>
                    <div class="alert alert-secondary mb-0" role="status" invisible="task_template_id">
                        Pick a template to get standard task stages, or leave empty and configure stages later.
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="project_project_quick_create_custom" model="ir.ui.view">
        <field name="name">project.project.quick.create.custom</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.quick_create_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="country_id" placeholder="Country" options="{'no_create': True, 'no_open': True}"/>
                <field name="task_template_id" string="Template" placeholder="Workflow template" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="project.open_create_project" model="ir.actions.act_window">
        <field name="group_ids" eval="[
            (4, ref('group_project_create_move')),
            (4, ref('group_project_custom_manager')),
            (4, ref('project.group_project_manager')),
        ]"/>
    </record>

    <record id="project_project_list_custom" model="ir.ui.view">
        <field name="name">project.project.list.custom</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="task_template_id" optional="hide"/>
                <field name="country_id" optional="show"/>
                <field name="sales_team_id" optional="show"/>
                <field name="progress_percentage" string="Progress %" widget="progressbar" readonly="1" options="{'editable': false}" optional="show"/>
                <field name="progress_range" optional="hide"/>
                <field name="estimated_hours" widget="compact_hours" optional="hide" readonly="1"/>
                <field name="spent_hours" widget="compact_hours" optional="hide" readonly="1"/>
                <field name="remaining_hours" widget="compact_hours" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="project_project_search_custom" model="ir.ui.view">
        <field name="name">project.project.search.custom</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="country_id"/>
                <field name="sales_team_id"/>
                <field name="task_template_id"/>
                <field name="progress_range"/>
            </xpath>
            <xpath expr="//filter[@name='own_projects']" position="after">
                <separator string="Progress"/>
                <filter string="0% - 20%" name="progress_0_20" domain="[('progress_range', '=', '0_20')]"/>
                <filter string="20% - 50%" name="progress_20_50" domain="[('progress_range', '=', '20_50')]"/>
                <filter string="50% - 80%" name="progress_50_80" domain="[('progress_range', '=', '50_80')]"/>
                <filter string="80% - 100%" name="progress_80_100" domain="[('progress_range', '=', '80_100')]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Project Stage" name="group_project_stage" context="{'group_by': 'stage_id'}"/>
                <filter string="Country" name="group_country" context="{'group_by': 'country_id'}"/>
                <filter string="Sales Team" name="group_sales_team" context="{'group_by': 'sales_team_id'}"/>
                <filter string="Task Template" name="group_task_template" context="{'group_by': 'task_template_id'}"/>
                <filter string="Progress Range" name="group_progress_range" context="{'group_by': 'progress_range'}"/>
            </xpath>
        </field>
    </record>

    <record id="project_project_kanban_custom" model="ir.ui.view">
        <field name="name">project.project.kanban.custom</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="progress_percentage"/>
            </xpath>
            <xpath expr="//div[hasclass('o_project_kanban_body')]" position="inside">
                <div class="o_project_kanban_progress"
                     t-if="!record.is_template.raw_value"
                     t-att-data-complete="record.progress_percentage.raw_value &gt;= 100 ? '1' : '0'">
                    <field name="progress_percentage" widget="progressbar" nolabel="1" readonly="1" class="o_project_kanban_progress_bar" options="{'editable': false}"/>
                    <span class="o_project_kanban_progress_pct"><t t-esc="record.progress_percentage.value"/>%</span>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
