<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_task_search_custom" model="ir.ui.view">
        <field name="name">project.task.search.custom</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='deadline_past_due']" position="after">
                <filter string="Overdue Tasks" name="overdue_tasks"
                    domain="[('date_deadline', '&lt;', 'today'), ('state', 'not in', ['1_done', '1_canceled'])]"/>
            </xpath>
            <xpath expr="//filter[@name='deadline']" position="after">
                <filter string="Employee" name="group_employee" context="{'group_by': 'user_ids'}"/>
                <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                <filter string="Task Status" name="group_state" context="{'group_by': 'state'}"/>
            </xpath>
        </field>
    </record>

</odoo>
