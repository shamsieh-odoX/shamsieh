<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_hr_overtime_request" model="ir.actions.report">
        <field name="name">Overtime Request</field>
        <field name="model">hr.overtime.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_overtime_management.report_hr_overtime_request</field>
        <field name="report_file">hr_overtime_management.report_hr_overtime_request</field>
        <field name="print_report_name">'Overtime - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_hr_overtime_request"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_hr_overtime_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Overtime Request <span t-field="doc.name"/></h2>
                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Employee:</strong> <span t-field="doc.employee_id"/><br/>
                                <strong>Department:</strong> <span t-field="doc.department_id"/><br/>
                                <strong>Manager:</strong> <span t-field="doc.manager_id"/><br/>
                            </div>
                            <div class="col-6">
                                <strong>Date:</strong> <span t-field="doc.date"/><br/>
                                <strong>Start:</strong> <span t-field="doc.start_datetime"/><br/>
                                <strong>End:</strong> <span t-field="doc.end_datetime"/><br/>
                                <strong>Hours:</strong> <span t-field="doc.overtime_hours" t-options="{'widget': 'float_time'}"/><br/>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Project:</strong> <span t-field="doc.project_id"/><br/>
                                <strong>Task:</strong> <span t-field="doc.task_id"/><br/>
                                <strong>Type:</strong> <span t-field="doc.overtime_type_id"/>
                                (<span t-field="doc.overtime_type_id.rate_multiplier"/>x)
                            </div>
                            <div class="col-6">
                                <strong>Status:</strong> <span t-field="doc.state"/><br/>
                                <strong>Hourly Cost:</strong> <span t-field="doc.hourly_cost" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/><br/>
                                <strong>Total Cost:</strong> <span t-field="doc.total_cost" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/><br/>
                            </div>
                        </div>
                        <div class="mt-3">
                            <strong>Description:</strong>
                            <p t-field="doc.description"/>
                        </div>
                        <h4 class="mt-4">Approval Trail</h4>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Role</th>
                                    <th>Approver</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Comment</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.approval_line_ids" t-as="line">
                                    <td><span t-field="line.role"/></td>
                                    <td><span t-field="line.approver_id"/></td>
                                    <td><span t-field="line.state"/></td>
                                    <td><span t-field="line.decision_date"/></td>
                                    <td><span t-field="line.comment"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
