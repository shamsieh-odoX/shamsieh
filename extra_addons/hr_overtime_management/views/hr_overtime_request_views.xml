<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_overtime_request_view_list" model="ir.ui.view">
        <field name="name">hr.overtime.request.list</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'refused'" decoration-success="state == 'hr_approved'">
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="department_id" optional="show"/>
                <field name="project_id"/>
                <field name="task_id" optional="show"/>
                <field name="date"/>
                <field name="overtime_hours" widget="float_time"/>
                <field name="overtime_type_id" optional="hide"/>
                <field name="total_cost" optional="hide"/>
                <field name="current_approver_id" optional="hide"/>
                <field name="state" widget="badge"
                    decoration-info="state in ('draft', 'submitted')"
                    decoration-warning="state in ('manager_approved', 'upper_manager_approved')"
                    decoration-success="state == 'hr_approved'"
                    decoration-danger="state == 'refused'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hr_overtime_request_view_form" model="ir.ui.view">
        <field name="name">hr.overtime.request.form</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="can_submit_request" invisible="1"/>
                    <field name="can_approve_request" invisible="1"/>
                    <field name="can_refuse_request" invisible="1"/>
                    <field name="can_cancel_request" invisible="1"/>
                    <field name="can_reset_request" invisible="1"/>
                    <field name="can_edit_employee_id" invisible="1"/>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary"
                        invisible="not can_submit_request"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                        invisible="not can_approve_request"/>
                    <button name="action_refuse" string="Refuse" type="object"
                        invisible="not can_refuse_request"/>
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="not can_cancel_request"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                        invisible="not can_reset_request"/>
                    <button name="action_print_report" string="Print" type="object"
                        invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,submitted,manager_approved,upper_manager_approved,hr_approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_approval_lines" type="object" class="oe_stat_button" icon="fa-check-square-o"
                            invisible="approval_line_count == 0">
                            <field name="approval_line_count" widget="statinfo" string="Approvals"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not daily_hours_warning">
                        <field name="daily_hours_warning" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Employee">
                            <field name="employee_company_id" invisible="1"/>
                            <field name="employee_id" readonly="not can_edit_employee_id"/>
                            <field name="department_id"/>
                            <field name="manager_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group string="Date &amp; Time">
                            <field name="start_datetime" readonly="state != 'draft'"/>
                            <field name="end_datetime" readonly="state != 'draft'"/>
                            <field name="date" readonly="1"/>
                            <field name="overtime_hours" widget="float_time"/>
                            <field name="overtime_type_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Project">
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="task_id" readonly="state != 'draft'"/>
                            <field name="description" readonly="state != 'draft'"/>
                            <field name="attachment_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                        </group>
                        <group string="Cost">
                            <field name="currency_id" invisible="1"/>
                            <field name="hourly_cost"/>
                            <field name="total_cost"/>
                            <field name="analytic_line_id" readonly="1"/>
                            <field name="current_approver_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approval History" name="approval_history">
                            <field name="approval_line_ids" readonly="1">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="role"/>
                                    <field name="approver_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="decision_date"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_overtime_request_view_kanban" model="ir.ui.view">
        <field name="name">hr.overtime.request.kanban</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="overtime_hours"/>
                <field name="state"/>
                <field name="current_approver_id"/>
                <field name="can_approve_request"/>
                <field name="can_refuse_request"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_title">
                                <strong><field name="name"/></strong>
                            </div>
                            <div><field name="employee_id" widget="many2one_avatar_employee"/></div>
                            <div><field name="project_id"/></div>
                            <div><field name="date"/> — <field name="overtime_hours" widget="float_time"/> h</div>
                            <div class="mt-2">
                                <button name="action_approve" type="object" class="btn btn-sm btn-primary me-1"
                                    invisible="not can_approve_request">
                                    Approve
                                </button>
                                <button name="action_refuse" type="object" class="btn btn-sm btn-secondary"
                                    invisible="not can_refuse_request">
                                    Refuse
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hr_overtime_request_view_search" model="ir.ui.view">
        <field name="name">hr.overtime.request.search</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="overtime_type_id"/>
                <field name="current_approver_id"/>
                <separator/>
                <filter string="My Requests" name="my_requests" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter string="My Approvals" name="my_approvals" domain="[('current_approver_id', '=', uid)]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Pending Approval" name="pending" domain="[('state', 'in', ('submitted', 'manager_approved', 'upper_manager_approved'))]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'hr_approved')]"/>
                <filter string="Refused" name="refused" domain="[('state', '=', 'refused')]"/>
                <separator/>
                <filter string="This Month" name="this_month"
                    domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                              ('date', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Last Month" name="last_month"
                    domain="[('date', '&gt;=', (context_today() - relativedelta(months=1, day=1)).strftime('%Y-%m-%d')),
                              ('date', '&lt;', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Task" name="group_task" context="{'group_by': 'task_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:month'}"/>
                    <filter string="Overtime Type" name="group_type" context="{'group_by': 'overtime_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_overtime_request_view_pivot" model="ir.ui.view">
        <field name="name">hr.overtime.request.pivot</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch" type="xml">
            <pivot string="Overtime Analysis">
                <field name="employee_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="overtime_hours" type="measure"/>
                <field name="total_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="hr_overtime_request_view_graph" model="ir.ui.view">
        <field name="name">hr.overtime.request.graph</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch" type="xml">
            <graph string="Overtime Analysis" type="bar">
                <field name="department_id"/>
                <field name="overtime_hours" type="measure"/>
                <field name="total_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_hr_overtime_request_window" model="ir.actions.act_window">
        <field name="name">Overtime Requests</field>
        <field name="res_model">hr.overtime.request</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first overtime request</p>
            <p>Submit overtime hours for manager and HR approval.</p>
        </field>
    </record>

    <record id="action_hr_overtime_open_my_requests" model="ir.actions.server">
        <field name="name">Overtime Requests</field>
        <field name="model_id" ref="model_hr_overtime_request"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_my_requests()</field>
    </record>

    <record id="action_hr_overtime_my_approvals_window" model="ir.actions.act_window">
        <field name="name">My Approvals</field>
        <field name="res_model">hr.overtime.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', 'in', ('submitted', 'manager_approved', 'upper_manager_approved'))]</field>
    </record>

    <record id="action_hr_overtime_open_my_approvals" model="ir.actions.server">
        <field name="name">My Approvals</field>
        <field name="model_id" ref="model_hr_overtime_request"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_my_approvals()</field>
    </record>

</odoo>
