<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_overtime_type_view_list" model="ir.ui.view">
        <field name="name">hr.overtime.type.list</field>
        <field name="model">hr.overtime.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="rate_multiplier"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="hr_overtime_type_view_form" model="ir.ui.view">
        <field name="name">hr.overtime.type.form</field>
        <field name="model">hr.overtime.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Regular Overtime"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="rate_multiplier"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_overtime_type_view_search" model="ir.ui.view">
        <field name="name">hr.overtime.type.search</field>
        <field name="model">hr.overtime.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <filter string="Regular" name="regular" domain="[('category', '=', 'regular')]"/>
                <filter string="Weekend" name="weekend" domain="[('category', '=', 'weekend')]"/>
                <filter string="Day Off" name="day_off" domain="[('category', '=', 'day_off')]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_hr_overtime_type" model="ir.actions.act_window">
        <field name="name">Overtime Types</field>
        <field name="res_model">hr.overtime.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
