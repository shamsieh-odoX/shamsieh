<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend To-Do form view -->
    <record id="project_task_view_todo_form_shams" model="ir.ui.view">
        <field name="name">project.task.view.todo.form.shams</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_todo.project_task_view_todo_form"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="is_shams_todo" invisible="1"/>
                <field name="owner_employee_id" invisible="1"/>
                <field name="manager_id" invisible="1"/>
            </field>
            <header position="inside">
                <field name="review_state"
                       widget="statusbar"
                       statusbar_visible="draft,in_progress,waiting_review,approved,rejected,cancelled"
                       invisible="not is_shams_todo"/>
                <button name="action_start"
                        string="Start"
                        type="object"
                        class="btn-primary"
                        invisible="not is_shams_todo or review_state not in ('draft', 'rejected')"/>
                <button name="action_submit_review"
                        string="Submit for Review"
                        type="object"
                        class="btn-primary"
                        invisible="not is_shams_todo or review_state != 'in_progress'"/>
                <button name="action_approve"
                        string="Approve"
                        type="object"
                        class="btn-primary"
                        groups="shams_todo_management.group_shams_todo_manager"
                        invisible="not is_shams_todo or review_state != 'waiting_review'"/>
                <button name="action_reject"
                        string="Reject"
                        type="object"
                        groups="shams_todo_management.group_shams_todo_manager"
                        invisible="not is_shams_todo or review_state != 'waiting_review'"/>
                <button name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="not is_shams_todo or review_state in ('approved', 'cancelled')"/>
            </header>
            <group position="after">
                <group invisible="not is_shams_todo">
                    <group>
                        <field name="owner_employee_id" readonly="1"/>
                        <field name="manager_id" readonly="1"/>
                        <field name="allocated_hours" string="Estimated Hours"/>
                        <field name="actual_hours"/>
                        <field name="progress" widget="progressbar"/>
                    </group>
                    <group>
                        <field name="reviewed_by" readonly="1"/>
                        <field name="reviewed_on" readonly="1"/>
                        <field name="review_note"
                               groups="shams_todo_management.group_shams_todo_manager"
                               invisible="review_state not in ('waiting_review', 'rejected', 'approved')"/>
                    </group>
                </group>
            </group>
            <field name="description" position="after">
                <notebook invisible="not is_shams_todo">
                    <page string="Daily Report" name="daily_report">
                        <group>
                            <field name="work_done" placeholder="What was completed today..."/>
                            <field name="what_learned" placeholder="What did you learn..."/>
                            <field name="blockers" placeholder="Issues or blockers..."/>
                            <field name="tomorrow_plan" placeholder="Plan for tomorrow..."/>
                        </group>
                    </page>
                </notebook>
            </field>
        </field>
    </record>

    <!-- Extend To-Do list view -->
    <record id="project_task_view_todo_tree_shams" model="ir.ui.view">
        <field name="name">project.task.view.todo.tree.shams</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_todo.project_task_view_todo_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="review_state" optional="show"/>
                <field name="owner_employee_id" optional="hide"/>
                <field name="allocated_hours" string="Est. Hours" optional="hide"/>
                <field name="actual_hours" optional="hide"/>
                <field name="progress" optional="hide" widget="progressbar"/>
            </field>
        </field>
    </record>

    <!-- Extend To-Do search view -->
    <record id="project_task_view_todo_search_shams" model="ir.ui.view">
        <field name="name">project.task.view.todo.search.shams</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_todo.project_task_view_todo_search"/>
        <field name="arch" type="xml">
            <field name="user_ids" position="after">
                <field name="owner_employee_id"/>
                <field name="manager_id"/>
                <field name="review_state"/>
            </field>
            <filter name="open_tasks" position="before">
                <filter name="my_tasks" string="My Tasks"
                        domain="[('owner_employee_id.user_id', '=', uid)]"/>
                <filter name="my_team" string="My Team"
                        domain="[('owner_employee_id.user_id', '!=', uid), ('visibility_user_ids', 'in', uid)]"
                        groups="shams_todo_management.group_shams_todo_manager"/>
                <filter name="waiting_review" string="Waiting Review"
                        domain="[('review_state', '=', 'waiting_review')]"/>
                <filter name="approved" string="Approved"
                        domain="[('review_state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected"
                        domain="[('review_state', '=', 'rejected')]"/>
                <separator/>
                <filter name="overdue" string="Overdue"
                        domain="[('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d')), ('review_state', 'not in', ('approved', 'cancelled'))]"/>
                <filter name="due_today" string="Due Today"
                        domain="[('date_deadline', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('date_deadline', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter name="completed_this_week" string="Completed This Week"
                        domain="[('review_state', '=', 'approved')]"
                        date="reviewed_on"/>
                <separator/>
            </filter>
            <filter name="deadline" position="after">
                <filter string="Review Status" name="groupby_review_state"
                        context="{'group_by': 'review_state'}"/>
                <filter string="Owner" name="groupby_owner"
                        context="{'group_by': 'owner_employee_id'}"/>
                <filter string="Manager" name="groupby_manager"
                        context="{'group_by': 'manager_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
