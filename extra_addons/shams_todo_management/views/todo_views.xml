<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_tree_shams_todo" model="ir.ui.view">
        <field name="name">project.task.tree.shams.todo</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <list string="To-Dos" default_order="priority desc, date_deadline asc">
                <field name="name"/>
                <field name="owner_employee_id"/>
                <field name="manager_id" optional="show"/>
                <field name="date_deadline"/>
                <field name="priority"/>
                <field name="review_state"/>
                <field name="progress"/>
                <field name="estimated_hours" optional="show"/>
                <field name="actual_hours" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_project_task_form_shams_todo" model="ir.ui.view">
        <field name="name">project.task.form.shams.todo</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <form string="To-Do">
                <header>
                    <button name="action_start" string="Start" type="object" class="oe_highlight" invisible="review_state != 'draft'"/>
                    <button name="action_submit_review" string="Submit Review" type="object" class="btn-primary" invisible="review_state not in ('draft', 'in_progress', 'rejected')"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="review_state != 'waiting_review' or not can_review"/>
                    <button name="action_reject" string="Reject" type="object" invisible="review_state != 'waiting_review' or not can_review"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="review_state == 'approved' or review_state == 'cancelled'"/>
                    <field name="review_state" widget="statusbar" statusbar_visible="draft,in_progress,waiting_review,approved,rejected,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="owner_employee_id"/>
                            <field name="manager_id" readonly="1"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="date_deadline"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="progress"/>
                            <field name="estimated_hours"/>
                            <field name="actual_hours"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Daily Work">
                            <group>
                                <field name="work_done" widget="html"/>
                                <field name="what_learned" widget="html"/>
                                <field name="blockers" widget="html"/>
                                <field name="tomorrow_plan" widget="html"/>
                            </group>
                        </page>
                        <page string="Review">
                            <group>
                                <field name="reviewed_by" readonly="1"/>
                                <field name="reviewed_on" readonly="1"/>
                                <field name="review_note" widget="html"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_project_task_search_shams_todo" model="ir.ui.view">
        <field name="name">project.task.search.shams.todo</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <search string="To-Do Search">
                <field name="name"/>
                <field name="owner_employee_id"/>
                <field name="manager_id"/>
                <field name="review_state"/>
                <field name="date_deadline"/>
                <filter name="my_tasks" string="My Tasks" domain="[('owner_employee_id.user_id', '=', uid)]"/>
                <filter name="my_team" string="My Team" domain="[('owner_employee_id', 'child_of', user.employee_id.id)]"/>
                <filter name="waiting_review" string="Waiting Review" domain="[('review_state', '=', 'waiting_review')]"/>
                <filter name="approved" string="Approved" domain="[('review_state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('review_state', '=', 'rejected')]"/>
                <filter name="overdue" string="Overdue" domain="[('date_deadline', '&lt;', context_today()), ('review_state', 'not in', ['approved', 'cancelled'])]"/>
                <filter name="due_today" string="Due Today" domain="[('date_deadline', '=', context_today())]"/>
                <filter
                    name="completed_this_week"
                    string="Completed This Week"
                    domain="[('review_state', '=', 'approved'), ('reviewed_on', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%%Y-%%m-%%d 00:00:00'))]"
                />
                <group expand="0" string="Group By">
                    <filter name="group_owner" string="Owner" context="{'group_by': 'owner_employee_id'}"/>
                    <filter name="group_manager" string="Manager" context="{'group_by': 'manager_id'}"/>
                    <filter name="group_state" string="Review State" context="{'group_by': 'review_state'}"/>
                    <filter name="group_deadline" string="Deadline" context="{'group_by': 'date_deadline'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_shams_todo_my_tasks" model="ir.actions.act_window">
        <field name="name">My To-Dos</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_project_task_tree_shams_todo"/>
        <field name="search_view_id" ref="view_project_task_search_shams_todo"/>
        <field name="domain">[('owner_employee_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_my_tasks': 1}</field>
    </record>

    <record id="action_shams_todo_team_tasks" model="ir.actions.act_window">
        <field name="name">My Team To-Dos</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_project_task_tree_shams_todo"/>
        <field name="search_view_id" ref="view_project_task_search_shams_todo"/>
        <field name="domain">[('owner_employee_id', 'child_of', user.employee_id.id)]</field>
        <field name="context">{'search_default_my_team': 1}</field>
    </record>

    <record id="action_shams_todo_waiting_review" model="ir.actions.act_window">
        <field name="name">Waiting Review</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_project_task_tree_shams_todo"/>
        <field name="search_view_id" ref="view_project_task_search_shams_todo"/>
        <field name="domain">[('review_state', '=', 'waiting_review')]</field>
        <field name="context">{'search_default_waiting_review': 1}</field>
    </record>
</odoo>
