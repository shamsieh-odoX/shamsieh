<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- My To-Dos -->
    <record id="project_task_action_my_todos" model="ir.actions.act_window">
        <field name="name">My To-Dos</field>
        <field name="res_model">project.task</field>
        <field name="path">my-to-dos</field>
        <field name="domain">[
            ('user_ids', 'in', [uid]),
            ('project_id', '=', False),
            ('parent_id', '=', False),
        ]</field>
        <field name="view_mode">kanban,list,form,calendar,activity</field>
        <field name="search_view_id" ref="project_todo.project_task_view_todo_search"/>
        <field name="context">{
            'search_default_open_tasks': 1,
            'list_view_ref': 'project_todo.project_task_view_todo_tree',
            'default_project_id': False,
            'show_todo_mail_helper': True,
            'show_task_options': False,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No to-do found. Let's create one!
            </p>
            <p>
                Create and track your daily work. Submit completed items for manager review.
            </p>
        </field>
    </record>

    <!-- My Team To-Dos -->
    <record id="project_task_action_team_todos" model="ir.actions.act_window">
        <field name="name">My Team To-Dos</field>
        <field name="res_model">project.task</field>
        <field name="path">team-to-dos</field>
        <field name="domain">[
            ('is_shams_todo', '=', True),
            ('owner_employee_id.user_id', '!=', uid),
            ('visibility_user_ids', 'in', uid),
        ]</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="project_todo.project_task_view_todo_search"/>
        <field name="context">{
            'search_default_open_tasks': 1,
            'list_view_ref': 'project_todo.project_task_view_todo_tree',
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No team to-dos found.
            </p>
            <p>
                To-dos from employees in your reporting hierarchy appear here.
            </p>
        </field>
    </record>

    <!-- Waiting Review -->
    <record id="project_task_action_waiting_review" model="ir.actions.act_window">
        <field name="name">Waiting Review</field>
        <field name="res_model">project.task</field>
        <field name="path">to-dos-waiting-review</field>
        <field name="domain">[
            ('is_shams_todo', '=', True),
            ('review_state', '=', 'waiting_review'),
            ('owner_employee_id.user_id', '!=', uid),
            ('visibility_user_ids', 'in', uid),
        ]</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="project_todo.project_task_view_todo_search"/>
        <field name="context">{
            'list_view_ref': 'project_todo.project_task_view_todo_tree',
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No to-dos waiting for review.
            </p>
            <p>
                Review and approve or reject submitted to-dos from your team.
            </p>
        </field>
    </record>

    <!-- Action view links -->
    <record model="ir.actions.act_window.view" id="action_my_todos_kanban">
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="project_todo.project_task_view_todo_kanban"/>
        <field name="act_window_id" ref="project_task_action_my_todos"/>
    </record>
    <record model="ir.actions.act_window.view" id="action_my_todos_list">
        <field name="view_mode">list</field>
        <field name="view_id" ref="project_todo.project_task_view_todo_tree"/>
        <field name="act_window_id" ref="project_task_action_my_todos"/>
    </record>
    <record model="ir.actions.act_window.view" id="action_my_todos_form">
        <field name="view_mode">form</field>
        <field name="view_id" ref="project_todo.project_task_view_todo_form"/>
        <field name="act_window_id" ref="project_task_action_my_todos"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_team_todos_list">
        <field name="view_mode">list</field>
        <field name="view_id" ref="project_todo.project_task_view_todo_tree"/>
        <field name="act_window_id" ref="project_task_action_team_todos"/>
    </record>
    <record model="ir.actions.act_window.view" id="action_team_todos_kanban">
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="project_todo.project_task_view_todo_kanban"/>
        <field name="act_window_id" ref="project_task_action_team_todos"/>
    </record>
    <record model="ir.actions.act_window.view" id="action_team_todos_form">
        <field name="view_mode">form</field>
        <field name="view_id" ref="project_todo.project_task_view_todo_form"/>
        <field name="act_window_id" ref="project_task_action_team_todos"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_waiting_review_list">
        <field name="view_mode">list</field>
        <field name="view_id" ref="project_todo.project_task_view_todo_tree"/>
        <field name="act_window_id" ref="project_task_action_waiting_review"/>
    </record>
    <record model="ir.actions.act_window.view" id="action_waiting_review_kanban">
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="project_todo.project_task_view_todo_kanban"/>
        <field name="act_window_id" ref="project_task_action_waiting_review"/>
    </record>
    <record model="ir.actions.act_window.view" id="action_waiting_review_form">
        <field name="view_mode">form</field>
        <field name="view_id" ref="project_todo.project_task_view_todo_form"/>
        <field name="act_window_id" ref="project_task_action_waiting_review"/>
    </record>

    <!-- Menus -->
    <menuitem id="menu_shams_todo_root"
              name="Team To-Dos"
              parent="project_todo.menu_todo_todos"
              sequence="5"
              groups="shams_todo_management.group_shams_todo_manager"/>

    <menuitem id="menu_my_todos"
              name="My To-Dos"
              parent="project_todo.menu_todo_todos"
              action="project_task_action_my_todos"
              sequence="1"/>

    <menuitem id="menu_team_todos"
              name="My Team To-Dos"
              parent="menu_shams_todo_root"
              action="project_task_action_team_todos"
              sequence="10"
              groups="shams_todo_management.group_shams_todo_manager"/>

    <menuitem id="menu_waiting_review"
              name="Waiting Review"
              parent="menu_shams_todo_root"
              action="project_task_action_waiting_review"
              sequence="20"
              groups="shams_todo_management.group_shams_todo_manager"/>

    <menuitem id="menu_all_team_reports"
              name="All Team Reports"
              parent="menu_shams_todo_root"
              action="project_task_action_team_reports"
              sequence="30"
              groups="shams_todo_management.group_shams_todo_manager"/>

</odoo>
