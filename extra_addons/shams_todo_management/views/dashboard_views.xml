<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_pivot_shams_todo" model="ir.ui.view">
        <field name="name">project.task.pivot.shams.todo</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <pivot string="Team To-Do Report">
                <field name="owner_employee_id" type="row"/>
                <field name="manager_id" type="row"/>
                <field name="review_state" type="col"/>
                <field name="estimated_hours" type="measure"/>
                <field name="actual_hours" type="measure"/>
                <field name="id" type="measure" string="Tasks"/>
            </pivot>
        </field>
    </record>

    <record id="view_project_task_graph_shams_todo" model="ir.ui.view">
        <field name="name">project.task.graph.shams.todo</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <graph string="To-Do Status Overview" type="bar">
                <field name="review_state"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_shams_todo_reports" model="ir.actions.act_window">
        <field name="name">All Team Reports</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="search_view_id" ref="view_project_task_search_shams_todo"/>
    </record>
</odoo>
