<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <!-- Extend standard To-Do rule so hierarchy and admins can see team to-dos -->
        <record id="project_todo.task_edition_rule_internal" model="ir.rule">
            <field name="name">Project/Task: employees: own or hierarchy to-dos</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">['|',
                '&amp;', ('project_id', '=', False), ('user_ids', 'in', user.id), ('parent_id', '=', False),
                '&amp;', ('project_id', '=', False), ('parent_id', '=', False), ('visibility_user_ids', 'in', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Employee: create own private to-dos -->
        <record id="shams_todo_rule_employee_create" model="ir.rule">
            <field name="name">Shams To-Do: employee create own</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[
                ('project_id', '=', False),
                ('parent_id', '=', False),
                '|',
                    ('owner_employee_id', '=', False),
                    ('owner_employee_id.user_id', '=', user.id),
            ]</field>
            <field name="groups" eval="[(4, ref('group_shams_todo_employee'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Employee: write own to-dos except approved -->
        <record id="shams_todo_rule_employee_write" model="ir.rule">
            <field name="name">Shams To-Do: employee write own</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[
                ('project_id', '=', False),
                ('parent_id', '=', False),
                ('owner_employee_id.user_id', '=', user.id),
                ('review_state', '!=', 'approved'),
            ]</field>
            <field name="groups" eval="[(4, ref('group_shams_todo_employee'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Manager: write subordinate to-dos waiting for review -->
        <record id="shams_todo_rule_manager_write_review" model="ir.rule">
            <field name="name">Shams To-Do: manager write waiting review</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[
                ('project_id', '=', False),
                ('parent_id', '=', False),
                ('review_state', '=', 'waiting_review'),
                ('owner_employee_id.user_id', '!=', user.id),
                ('visibility_user_ids', 'in', user.id),
            ]</field>
            <field name="groups" eval="[(4, ref('group_shams_todo_manager'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Admin: full access to all to-dos -->
        <record id="shams_todo_rule_admin" model="ir.rule">
            <field name="name">Shams To-Do: administrator full access</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[
                ('project_id', '=', False),
                ('parent_id', '=', False),
            ]</field>
            <field name="groups" eval="[(4, ref('group_shams_todo_admin'))]"/>
        </record>

    </data>
</odoo>
