<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_shams_todo" model="ir.module.category">
        <field name="name">Shams To-Do</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_shams_todo_employee" model="res.groups">
        <field name="name">To-Do Employee</field>
        <field name="category_id" ref="shams_todo_management.module_category_shams_todo"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_shams_todo_manager" model="res.groups">
        <field name="name">To-Do Manager</field>
        <field name="category_id" ref="shams_todo_management.module_category_shams_todo"/>
        <field name="implied_ids" eval="[(4, ref('shams_todo_management.group_shams_todo_employee'))]"/>
    </record>

    <record id="group_shams_todo_admin" model="res.groups">
        <field name="name">To-Do Admin</field>
        <field name="category_id" ref="shams_todo_management.module_category_shams_todo"/>
        <field name="implied_ids" eval="[(4, ref('shams_todo_management.group_shams_todo_manager'))]"/>
    </record>
</odoo>
