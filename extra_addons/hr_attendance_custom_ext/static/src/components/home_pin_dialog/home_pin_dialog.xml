<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="hr_attendance_custom_ext.HomePinDialog">
    <Dialog title="'Home PIN Check In'" size="'sm'">
        <div class="d-flex flex-column gap-3">
            <p class="mb-0 text-muted">
                Enter your personal home attendance PIN to complete check in.
            </p>
            <input class="form-control"
                   type="password"
                   t-model="state.pinCode"
                   placeholder="PIN code"
                   autocomplete="off"/>
            <div t-if="state.error" class="alert alert-danger mb-0" role="alert">
                <t t-esc="state.error"/>
            </div>
        </div>
        <t t-set-slot="footer">
            <button class="btn btn-secondary" t-on-click="props.close" t-att-disabled="state.processing">
                Cancel
            </button>
            <button class="btn btn-primary" t-on-click="submitPin" t-att-disabled="state.processing or !state.pinCode">
                <t t-if="state.processing">Checking...</t>
                <t t-else="">Check In with PIN</t>
            </button>
        </t>
    </Dialog>
</t>

</templates>
