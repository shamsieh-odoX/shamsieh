<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_face_enroll_wizard_form" model="ir.ui.view">
        <field name="name">hr.employee.face.enroll.wizard.form</field>
        <field name="model">hr.employee.face.enroll.wizard</field>
        <field name="arch" type="xml">
            <form string="Enroll Face Template">
                <group>
                    <field name="employee_id" readonly="1"/>
                    <field name="enrollment_image" filename="enrollment_image_filename" widget="image"/>
                    <field name="enrollment_image_filename" invisible="1"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_enroll" type="object" string="Enroll" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
