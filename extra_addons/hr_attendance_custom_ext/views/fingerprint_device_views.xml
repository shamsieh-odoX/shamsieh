<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fingerprint_device_tree" model="ir.ui.view">
        <field name="name">fingerprint.device.list</field>
        <field name="model">fingerprint.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="device_ip"/>
                <field name="api_type"/>
                <field name="sync_status"/>
                <field name="last_sync_at"/>
                <field name="log_count" string="Logs"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fingerprint_device_form" model="ir.ui.view">
        <field name="name">fingerprint.device.form</field>
        <field name="model">fingerprint.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="sync_status" widget="statusbar" statusbar_visible="idle,running,success,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_logs"
                                icon="fa-list" groups="hr_attendance.group_hr_attendance_officer">
                            <field name="log_count" widget="statinfo" string="Sync Logs"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="policy_id"/>
                            <field name="api_type"/>
                            <field name="active"/>
                            <field name="auto_sync" readonly="1"/>
                            <field name="sync_interval_minutes" readonly="1"/>
                            <field name="sync_lookback_hours" invisible="api_type != 'hikvision'"/>
                            <field name="device_timezone" invisible="api_type != 'hikvision'"
                                   placeholder="e.g. Asia/Amman"/>
                            <field name="connection_timeout" invisible="api_type != 'hikvision'"/>
                            <field name="sync_retry_count" invisible="api_type != 'hikvision'"/>
                            <field name="store_ignored_events" invisible="api_type != 'hikvision'"/>
                        </group>
                        <group>
                            <field name="device_ip"/>
                            <field name="device_port"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="api_key" password="True" invisible="api_type != 'custom_api'"/>
                        </group>
                    </group>
                    <group string="File Import" invisible="api_type != 'file_import'">
                        <field name="import_file_name" invisible="1"/>
                        <field name="import_file_data" filename="import_file_name"/>
                    </group>
                    <group string="Automatic Sync">
                        <div class="text-muted" colspan="2">
                            When HTTP Listening is enabled below, scans appear in Odoo within seconds.
                            Otherwise events are fetched every minute (near-live polling).
                            The scheduled sync remains as a backup when HTTP listening is active.
                            Open Sync Logs to browse all imported events.
                        </div>
                        <field name="last_sync_at" readonly="1"/>
                        <field name="last_sync_checkpoint" readonly="1"/>
                        <field name="last_successful_event_serial" readonly="1"/>
                        <field name="last_sync_message" readonly="1"/>
                    </group>
                    <group string="Live HTTP Listening" invisible="api_type != 'hikvision'">
                        <div class="text-muted" colspan="2">
                            Enable push-based live sync: copy the Callback URL into the device
                            configuration (Network / HTTP Listening). The device must be able to
                            reach your Odoo server on the LAN or production network.
                        </div>
                        <field name="http_listening_enabled"/>
                        <field name="http_listening_url" readonly="1" widget="CopyClipboardChar"/>
                        <button name="action_regenerate_http_listening_token"
                                type="object"
                                string="Regenerate Token"
                                class="btn-secondary"
                                groups="hr_attendance_custom_ext.group_fingerprint_device_manager"
                                invisible="not http_listening_enabled"/>
                        <field name="http_listening_allowed_ips"/>
                        <field name="http_listening_last_at" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fingerprint_device" model="ir.actions.act_window">
        <field name="name">Fingerprint Devices</field>
        <field name="res_model">fingerprint.device</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
