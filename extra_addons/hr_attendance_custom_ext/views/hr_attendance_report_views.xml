<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_attendance_lateness_report" model="ir.actions.act_window">
        <field name="name">Lateness Report</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('attendance_status', '=', 'late')]</field>
        <field name="context">{'search_default_groupby_name': 1, 'search_default_employee': 1}</field>
        <field name="search_view_id" ref="hr_attendance.hr_attendance_view_filter"/>
    </record>

    <record id="action_attendance_missing_checkout_report" model="ir.actions.act_window">
        <field name="name">Missing Checkout Report</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('missing_checkout', '=', True)]</field>
        <field name="search_view_id" ref="hr_attendance.hr_attendance_view_filter"/>
    </record>

    <record id="action_attendance_missing_report" model="ir.actions.act_window">
        <field name="name">Incomplete Attendance Report</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('attendance_status', 'in', ['incomplete', 'absent'])]</field>
        <field name="search_view_id" ref="hr_attendance.hr_attendance_view_filter"/>
    </record>
</odoo>
