<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fingerprint_attendance_policy_tree" model="ir.ui.view">
        <field name="name">fingerprint.attendance.policy.list</field>
        <field name="model">fingerprint.attendance.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="process_mode"/>
                <field name="is_company_default"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fingerprint_attendance_policy_form" model="ir.ui.view">
        <field name="name">fingerprint.attendance.policy.form</field>
        <field name="model">fingerprint.attendance.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                            <field name="is_company_default"/>
                            <field name="process_mode"/>
                        </group>
                        <group string="Processing">
                            <field name="duplicate_scan_window_minutes"/>
                            <field name="minimum_checkout_gap_minutes"/>
                            <field name="max_shift_hours"/>
                            <field name="allow_multiple_attendances_per_day"/>
                            <field name="allow_overnight_shift"/>
                            <field name="ignore_middle_scans"/>
                        </group>
                    </group>
                    <group string="Grace and Tolerance">
                        <group>
                            <field name="late_grace_minutes"/>
                            <field name="early_checkout_grace_minutes"/>
                            <field name="missing_checkout_tolerance_minutes"/>
                        </group>
                        <group>
                            <field name="raw_payload_retention_days"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fingerprint_attendance_policy" model="ir.actions.act_window">
        <field name="name">Attendance Policies</field>
        <field name="res_model">fingerprint.attendance.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fingerprint_attendance_policy"
              name="Attendance Policies"
              parent="hr_attendance.menu_hr_attendance_configuration"
              action="action_fingerprint_attendance_policy"
              sequence="25"
              groups="hr_attendance.group_hr_attendance_manager"/>
</odoo>
