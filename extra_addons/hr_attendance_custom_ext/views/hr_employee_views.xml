<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_attendance_custom" model="ir.ui.view">
        <field name="name">hr.employee.form.attendance.custom</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_attendance.view_employee_form_inherit_hr_attendance"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='identification_group']" position="after">
                <group string="Attendance &amp; Face Recognition"
                       name="attendance_face_group"
                       colspan="2"
                       groups="hr_attendance.group_hr_attendance_officer">
                    <group string="Device &amp; Policy">
                        <field name="biometric_device_user_id"
                               placeholder="e.g. 10042"/>
                        <field name="attendance_required"/>
                        <field name="remote_attendance_allowed"/>
                    </group>
                    <group string="InsightFace Provider">
                        <field name="face_provider" readonly="1"/>
                        <field name="face_provider_available" readonly="1"/>
                        <field name="face_attendance_stub_enabled"
                               readonly="1"
                               invisible="face_provider_available"/>
                    </group>
                    <group string="Face Enrollment" colspan="2">
                        <group>
                            <field name="face_enrollment_status"
                                   readonly="1"
                                   widget="badge"
                                   decoration-success="face_enrollment_status == 'enrolled'"
                                   decoration-warning="face_enrollment_status == 'reset'"
                                   decoration-muted="face_enrollment_status == 'none'"/>
                            <field name="face_enrolled_at"
                                   readonly="1"
                                   invisible="face_enrollment_status != 'enrolled'"/>
                            <field name="face_enrolled_by"
                                   readonly="1"
                                   widget="many2one_avatar_user"
                                   invisible="face_enrollment_status != 'enrolled'"/>
                            <field name="active_face_template_id"
                                   readonly="1"
                                   invisible="face_enrollment_status != 'enrolled'"/>
                        </group>
                        <group>
                            <field name="face_template_id"
                                   readonly="1"
                                   invisible="face_enrollment_status != 'enrolled'"/>
                            <field name="face_reference_id"
                                   placeholder="Optional external reference"
                                   invisible="face_enrollment_status == 'none'"/>
                        </group>
                        <div class="d-flex flex-wrap gap-2 mt-2" colspan="2">
                            <button name="action_open_face_enroll_wizard"
                                    type="object"
                                    string="Enroll Face"
                                    class="btn-primary"
                                    icon="fa-camera"/>
                            <button name="action_reset_face_enrollment"
                                    type="object"
                                    string="Reset"
                                    class="btn-secondary"
                                    icon="fa-undo"
                                    invisible="face_enrollment_status != 'enrolled'"
                                    confirm="Deactivate all face templates for this employee?"/>
                            <button name="action_view_face_templates"
                                    type="object"
                                    string="View Templates"
                                    class="btn-link"
                                    icon="fa-list"/>
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
