<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_fingerprint_device_manager" model="res.groups">
        <field name="name">Fingerprint Device Manager</field>
        <field name="comment">Configure fingerprint devices and run manual sync.</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
        <field name="implied_ids" eval="[(4, ref('hr_attendance.group_hr_attendance_user'))]"/>
    </record>

    <data noupdate="1">
        <record id="fingerprint_device_company_rule" model="ir.rule">
            <field name="name">Fingerprint Device: multi-company</field>
            <field name="model_id" ref="model_fingerprint_device"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="fingerprint_device_log_company_rule" model="ir.rule">
            <field name="name">Fingerprint Device Log: multi-company</field>
            <field name="model_id" ref="model_fingerprint_device_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="face_attendance_log_employee_rule" model="ir.rule">
            <field name="name">Face Attendance Log: own records</field>
            <field name="model_id" ref="model_face_attendance_log"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_own_reader'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="face_attendance_log_officer_rule" model="ir.rule">
            <field name="name">Face Attendance Log: HR officers all</field>
            <field name="model_id" ref="model_face_attendance_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
        </record>
    </data>
</odoo>
