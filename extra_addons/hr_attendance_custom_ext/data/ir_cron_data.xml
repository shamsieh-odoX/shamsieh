<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_fingerprint_sync_all" model="ir.cron">
        <field name="name">Fingerprint: Sync All Devices</field>
        <field name="model_id" ref="model_fingerprint_device"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_all()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_fingerprint_process_pending" model="ir.cron">
        <field name="name">Fingerprint: Process Pending Logs</field>
        <field name="model_id" ref="model_fingerprint_device_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_pending()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_attendance_recompute_status" model="ir.cron">
        <field name="name">Attendance: Recompute Late/Early Status</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">model._cron_recompute_status()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_attendance_flag_missing_checkouts" model="ir.cron">
        <field name="name">Attendance: Flag Missing Checkouts</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">model._cron_flag_missing_checkouts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
