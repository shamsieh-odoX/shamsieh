            <xpath expr="//kanban" position="inside">
                <field name="lead_ref"/>
                <field name="sector"/>
                <field name="channel"/>
                <field name="interest_level"/>
                <field name="next_followup_date"/>
            </xpath>
            <xpath expr="//t[@t-name='card']/field[@name='name']" position="before">
                <div class="o_crm_custom_kanban_header d-flex flex-wrap align-items-center justify-content-between gap-1 mb-2">
                    <span class="o_crm_lead_ref_badge" invisible="not lead_ref">
                        <field name="lead_ref"/>
                    </span>
                    <field name="interest_level"
                        widget="label_selection"
                        invisible="not interest_level"
                        options="{'classes': {'hot': 'danger', 'warm': 'warning', 'cold': 'info', 'not_interested': 'secondary'}}"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="before">
                <div class="o_crm_custom_kanban_meta d-flex flex-wrap align-items-center gap-1 mb-2" invisible="not sector and not channel">
                    <field name="sector" widget="badge" invisible="not sector"/>
                    <field name="channel" widget="badge" invisible="not channel"/>
