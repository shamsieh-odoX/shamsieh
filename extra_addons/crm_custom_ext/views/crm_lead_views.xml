                <div class="o_crm_custom_kanban_followup d-flex align-items-center text-muted small mb-2" invisible="not next_followup_date">
                    <i class="fa fa-clock-o me-1"/>
                    <span class="me-1">Follow-up</span>
                    <field name="next_followup_date"/>
                </div>
            </xpath>
        </field>
