<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="crm.stage" id="crm.stage_lead1">
            <field name="name">New Lead</field>
            <field name="sequence">1</field>
        </record>
        <record model="crm.stage" id="crm.stage_lead2">
            <field name="name">Contacted</field>
            <field name="sequence">2</field>
        </record>
        <record model="crm.stage" id="crm.stage_lead3">
            <field name="name">Proposal Sent</field>
            <field name="sequence">6</field>
        </record>
        <record model="crm.stage" id="crm.stage_lead4">
            <field name="name">Won</field>
            <field name="sequence">11</field>
            <field name="is_won" eval="True"/>
        </record>
    </data>

    <data noupdate="1">
        <record model="crm.stage" id="stage_shamsieh_qualified">
            <field name="name">Qualified</field>
            <field name="sequence">3</field>
            <field name="color">4</field>
        </record>
        <record model="crm.stage" id="stage_shamsieh_demo_scheduled">
            <field name="name">Demo Scheduled</field>
            <field name="sequence">4</field>
            <field name="color">7</field>
        </record>
        <record model="crm.stage" id="stage_shamsieh_demo_completed">
            <field name="name">Demo Completed</field>
            <field name="sequence">5</field>
            <field name="color">3</field>
        </record>
        <record model="crm.stage" id="stage_shamsieh_negotiation">
            <field name="name">Negotiation</field>
            <field name="sequence">7</field>
            <field name="color">2</field>
        </record>
        <record model="crm.stage" id="stage_shamsieh_pending_decision">
            <field name="name">Pending Decision</field>
            <field name="sequence">8</field>
            <field name="color">6</field>
        </record>
        <record model="crm.stage" id="stage_shamsieh_followup_required">
            <field name="name">Follow-up Required</field>
            <field name="sequence">9</field>
            <field name="color">1</field>
        </record>
        <record model="crm.stage" id="stage_shamsieh_on_hold">
            <field name="name">On Hold</field>
            <field name="sequence">10</field>
            <field name="fold" eval="True"/>
            <field name="color">9</field>
        </record>
        <record model="crm.stage" id="stage_shamsieh_lost">
            <field name="name">Lost</field>
            <field name="sequence">12</field>
            <field name="fold" eval="True"/>
            <field name="color">0</field>
        </record>
    </data>
</odoo>
