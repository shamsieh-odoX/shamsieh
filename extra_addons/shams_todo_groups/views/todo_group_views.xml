<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shams_todo_group_view_list" model="ir.ui.view">
        <field name="name">shams.todo.group.list</field>
        <field name="model">shams.todo.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="member_count" string="Members"/>
                <field name="manager_count" string="Managers"/>
                <field name="task_count" string="Tasks"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="shams_todo_group_view_kanban" model="ir.ui.view">
        <field name="name">shams.todo.group.kanban</field>
        <field name="model">shams.todo.group</field>
        <field name="arch" type="xml">
            <kanban class="o_shams_todo_group_kanban" sample="1" highlight_color="color">
                <field name="name"/>
                <field name="description"/>
                <field name="member_count"/>
                <field name="manager_count"/>
                <field name="task_count"/>
                <field name="color"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                        </div>
                        <div class="o_kanban_record_body">
                            <div class="o_shams_todo_group_meta mb-2" t-if="record.description.raw_value">
                                <field name="description"/>
                            </div>
                            <div class="d-flex gap-3 o_shams_todo_group_meta">
                                <span><i class="fa fa-users me-1"/> <field name="member_count"/> members</span>
                                <span><i class="fa fa-tasks me-1"/> <field name="task_count"/> tasks</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="shams_todo_group_view_form" model="ir.ui.view">
        <field name="name">shams.todo.group.form</field>
        <field name="model">shams.todo.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks" type="object"
                            class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Group name..."/></h1>
                    </div>
                    <group>
                        <group string="Group">
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="About">
                            <field name="description" nolabel="1"
                                placeholder="What is this group for? Who should use it?"/>
                        </group>
                    </group>
                    <group string="Team">
                        <group>
                            <field name="member_ids"
                                widget="many2many_avatar_user"
                                domain="[('share', '=', False)]"
                                options="{'no_create': True, 'no_quick_create': True}"
                                placeholder="Select members..."/>
                        </group>
                        <group>
                            <field name="manager_ids"
                                widget="many2many_avatar_user"
                                domain="[('share', '=', False)]"
                                options="{'no_create': True, 'no_quick_create': True}"
                                placeholder="Select managers..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids" context="{'default_group_id': id}">
                                <list editable="bottom" decoration-muted="is_done">
                                    <field name="is_done" widget="shams_todo_done_checkmark" nolabel="1" width="30px"/>
                                    <field name="name"/>
                                    <field name="assigned_user_id" widget="many2one_avatar_user"
                                        options="{'no_create': True}"/>
                                    <field name="due_date"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="status" widget="badge"
                                        decoration-info="status == 'todo'"
                                        decoration-warning="status in ('in_progress', 'waiting_review')"
                                        decoration-success="status == 'done'"
                                        decoration-muted="status == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shams_todo_group_view_search" model="ir.ui.view">
        <field name="name">shams.todo.group.search</field>
        <field name="model">shams.todo.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="member_ids"/>
                <field name="manager_ids"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="My Groups" name="my_groups" domain="[('member_ids', 'in', uid)]"/>
                <filter string="Managed by Me" name="managed_by_me" domain="[('manager_ids', 'in', uid)]"/>
                <group>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shams_todo_group_action" model="ir.actions.act_window">
        <field name="name">To-Do Groups</field>
        <field name="res_model">shams.todo.group</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_my_groups': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a team group
            </p>
            <p>
                Groups let teammates share tasks with clear membership and manager roles.
            </p>
        </field>
    </record>

    <record id="shams_todo_group_action_configuration" model="ir.actions.act_window">
        <field name="name">To-Do Groups Configuration</field>
        <field name="res_model">shams.todo.group</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure To-Do groups
            </p>
            <p>
                Manage all groups, members, and managers across the organization.
            </p>
        </field>
    </record>

    <record id="shams_todo_group_action_my_groups" model="ir.actions.act_window">
        <field name="name">My Groups</field>
        <field name="res_model">shams.todo.group</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('member_ids', 'in', uid)]</field>
        <field name="context">{'search_default_my_groups': 1}</field>
    </record>

</odoo>
