<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shams_todo_task_view_list" model="ir.ui.view">
        <field name="name">shams.todo.task.list</field>
        <field name="model">shams.todo.task</field>
        <field name="arch" type="xml">
            <list decoration-muted="is_done"
                decoration-danger="is_overdue"
                multi_edit="1"
                default_order="is_done asc, due_date asc, priority desc, id desc">
                <field name="is_done" widget="shams_todo_done_checkmark" nolabel="1"
                    width="30px" class="o_shams_todo_done_checkmark_cell"/>
                <field name="name"/>
                <field name="group_id" optional="show"/>
                <field name="assigned_user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="due_date" optional="show"/>
                <field name="priority" widget="priority" optional="show" width="40px"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="is_overdue" column_invisible="True"/>
                <field name="status" optional="hide" widget="badge"
                    decoration-info="status == 'todo'"
                    decoration-warning="status in ('in_progress', 'waiting_review')"
                    decoration-success="status == 'done'"
                    decoration-muted="status == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="shams_todo_task_view_form_quick_create" model="ir.ui.view">
        <field name="name">shams.todo.task.form.quick.create</field>
        <field name="model">shams.todo.task</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" placeholder="What needs to be done?"/>
                    <field name="group_id" options="{'no_create': True}"/>
                    <field name="member_user_ids" invisible="1"/>
                    <label for="assigned_user_id"/>
                    <div class="o_row">
                        <field name="assigned_user_id" widget="many2one_avatar_user"
                            class="oe_inline" options="{'no_create': True}"/>
                        <button name="action_assign_to_me" type="object"
                            string="Assign to me" class="btn-link px-2"
                            invisible="assigned_user_id == uid"/>
                    </div>
                    <field name="due_date"/>
                    <field name="priority" widget="priority"/>
                </group>
            </form>
        </field>
    </record>

    <record id="shams_todo_task_view_form" model="ir.ui.view">
        <field name="name">shams.todo.task.form</field>
        <field name="model">shams.todo.task</field>
        <field name="arch" type="xml">
            <form class="o_shams_todo_form">
                <sheet class="o_shams_todo_form_sheet">
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div class="oe_title flex-grow-1">
                            <label for="name" class="text-muted"/>
                            <h1>
                                <field name="name" placeholder="Task title..." class="o_text_overflow"/>
                            </h1>
                        </div>
                        <div class="d-flex align-items-center gap-3 mt-2">
                            <field name="priority" widget="priority" class="h2 mb-0"/>
                            <field name="is_done" widget="shams_todo_done_checkmark" nolabel="1"/>
                        </div>
                    </div>
                    <group>
                        <group string="Assignment">
                            <field name="group_id" options="{'no_create': True}"/>
                            <field name="member_user_ids" invisible="1"/>
                            <label for="assigned_user_id"/>
                            <div class="o_row">
                                <field name="assigned_user_id" widget="many2one_avatar_user"
                                    class="oe_inline"
                                    options="{'no_create': True}"/>
                                <button name="action_assign_to_me" type="object"
                                    string="Assign to me" class="btn-link px-2"
                                    invisible="assigned_user_id == uid"/>
                            </div>
                            <field name="created_by_id" widget="many2one_avatar_user" readonly="1"/>
                        </group>
                        <group string="Schedule">
                            <field name="due_date"/>
                            <field name="completed_date" invisible="not is_done"/>
                            <field name="is_overdue" invisible="1"/>
                            <field name="status" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                            <field name="color" invisible="1"/>
                        </group>
                    </group>
                    <label for="description" string="Description"/>
                    <field name="description" placeholder="Add details, links, or notes for the team..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="shams_todo_task_view_kanban" model="ir.ui.view">
        <field name="name">shams.todo.task.kanban</field>
        <field name="model">shams.todo.task</field>
        <field name="arch" type="xml">
            <kanban class="o_shams_todo_kanban"
                quick_create_view="shams_todo_groups.shams_todo_task_view_form_quick_create"
                sample="1"
                highlight_color="color"
                default_order="is_done asc, priority desc, due_date asc, id desc">
                <field name="name"/>
                <field name="group_id"/>
                <field name="assigned_user_id"/>
                <field name="due_date"/>
                <field name="priority"/>
                <field name="status"/>
                <field name="is_done"/>
                <field name="is_overdue"/>
                <field name="active"/>
                <field name="color"/>
                <field name="activity_state"/>
                <templates>
                    <t t-name="menu">
                        <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card">
                        <div t-att-class="{'opacity-50': record.is_done.raw_value}">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <span class="o_shams_todo_group_badge mb-2">
                                    <field name="group_id"/>
                                </span>
                                <div t-if="record.due_date.raw_value"
                                    t-att-class="record.is_overdue.raw_value ? 'o_shams_todo_overdue' : 'text-muted'">
                                    <i class="fa fa-calendar me-1" title="Due Date"/>
                                    <field name="due_date"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                                <div class="oe_kanban_bottom_right d-flex align-items-center gap-2">
                                    <field name="assigned_user_id" widget="many2one_avatar_user"/>
                                    <field name="is_done" widget="shams_todo_done_checkmark" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="shams_todo_task_view_calendar" model="ir.ui.view">
        <field name="name">shams.todo.task.calendar</field>
        <field name="model">shams.todo.task</field>
        <field name="arch" type="xml">
            <calendar string="Tasks" date_start="due_date" color="group_id" mode="month"
                event_open_popup="1" quick_create="0">
                <field name="name"/>
                <field name="group_id"/>
                <field name="assigned_user_id" avatar_field="avatar_128"/>
                <field name="priority"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <record id="shams_todo_task_view_pivot" model="ir.ui.view">
        <field name="name">shams.todo.task.pivot</field>
        <field name="model">shams.todo.task</field>
        <field name="arch" type="xml">
            <pivot string="Tasks by Group" sample="1">
                <field name="group_id" type="row"/>
                <field name="status" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="shams_todo_task_view_graph" model="ir.ui.view">
        <field name="name">shams.todo.task.graph</field>
        <field name="model">shams.todo.task</field>
        <field name="arch" type="xml">
            <graph string="Tasks Overview" type="bar" sample="1">
                <field name="group_id"/>
                <field name="status" type="col"/>
            </graph>
        </field>
    </record>

    <record id="shams_todo_task_view_search" model="ir.ui.view">
        <field name="name">shams.todo.task.search</field>
        <field name="model">shams.todo.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Task"/>
                <field name="group_id"/>
                <field name="assigned_user_id"/>
                <field name="created_by_id"/>
                <filter string="Open" name="open_tasks"
                    domain="[('status', 'not in', ['done', 'cancelled'])]"/>
                <filter string="My Tasks" name="my_tasks" domain="[('assigned_user_id', '=', uid)]"/>
                <separator/>
                <filter string="Due Today" name="due_today"
                    domain="[('due_date', '=', context_today)]"/>
                <filter string="Overdue" name="overdue"
                    domain="[('due_date', '&lt;', context_today), ('status', 'not in', ['done', 'cancelled'])]"/>
                <filter string="In Progress" name="in_progress" domain="[('status', '=', 'in_progress')]"/>
                <filter string="Waiting Review" name="waiting_review" domain="[('status', '=', 'waiting_review')]"/>
                <filter string="Done" name="done" domain="[('status', '=', 'done')]"/>
                <separator/>
                <filter string="High Priority" name="high_priority"
                    domain="[('priority', 'in', ['2', '3'])]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Group" name="group_by_group" context="{'group_by': 'group_id'}"/>
                    <filter string="Assigned User" name="group_by_assigned_user" context="{'group_by': 'assigned_user_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Priority" name="group_by_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Due Date" name="group_by_due_date" context="{'group_by': 'due_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shams_todo_task_action" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">shams.todo.task</field>
        <field name="view_mode">kanban,list,calendar,graph,pivot,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first group task
            </p>
            <p>
                Pick a group, assign a teammate, and track progress on the kanban board.
            </p>
        </field>
    </record>

    <record id="shams_todo_task_action_my_tasks" model="ir.actions.act_window">
        <field name="name">My Assigned Tasks</field>
        <field name="res_model">shams.todo.task</field>
        <field name="view_mode">kanban,list,calendar,form</field>
        <field name="domain">[('assigned_user_id', '=', uid)]</field>
        <field name="context">{'search_default_my_tasks': 1, 'search_default_open_tasks': 1}</field>
    </record>

    <record id="shams_todo_task_action_group_tasks" model="ir.actions.act_window">
        <field name="name">Group Tasks</field>
        <field name="res_model">shams.todo.task</field>
        <field name="view_mode">kanban,list,calendar,graph,form</field>
        <field name="domain">[('group_id.member_ids', 'in', uid)]</field>
        <field name="context">{'search_default_open_tasks': 1}</field>
    </record>

    <record id="shams_todo_task_action_all_tasks" model="ir.actions.act_window">
        <field name="name">All Group Tasks</field>
        <field name="res_model">shams.todo.task</field>
        <field name="view_mode">kanban,list,calendar,graph,pivot,form</field>
    </record>

</odoo>
