<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_balance_summary_view_list" model="ir.ui.view">
        <field name="name">hr.leave.balance.summary.list</field>
        <field name="model">hr.leave.balance.summary</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="leave_type_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="as_of_date" optional="hide"/>
                <field name="total_accrued"/>
                <field name="days_used"/>
                <field name="days_remaining"/>
                <field name="carried_over"/>
                <field name="current_year_balance"/>
                <field name="total_available"/>
            </list>
        </field>
    </record>

    <record id="hr_leave_balance_summary_view_search" model="ir.ui.view">
        <field name="name">hr.leave.balance.summary.search</field>
        <field name="model">hr.leave.balance.summary</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="leave_type_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="as_of_date"/>
                <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                <filter string="Time Off Type" name="group_leave_type" context="{'group_by': 'leave_type_id'}"/>
                <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_leave_balance_summary" model="ir.actions.server">
        <field name="name">Employee Balance Summary</field>
        <field name="model_id" ref="model_hr_leave_balance_summary"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_report()</field>
    </record>

</odoo>
