<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_exceptional_holiday_view_list" model="ir.ui.view">
        <field name="name">hr.exceptional.holiday.list</field>
        <field name="model">hr.exceptional.holiday</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'refused'" decoration-success="state == 'hr_approved'">
                <field name="reference"/>
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="current_approver_id" optional="hide"/>
                <field name="state" widget="badge"
                    decoration-info="state in ('draft', 'submitted')"
                    decoration-warning="state in ('manager_approved', 'upper_manager_approved')"
                    decoration-success="state == 'hr_approved'"
                    decoration-danger="state == 'refused'"/>
            </list>
        </field>
    </record>

    <record id="hr_exceptional_holiday_view_form" model="ir.ui.view">
        <field name="name">hr.exceptional.holiday.form</field>
        <field name="model">hr.exceptional.holiday</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="can_submit_request" invisible="1"/>
                    <field name="can_approve_request" invisible="1"/>
                    <field name="can_refuse_request" invisible="1"/>
                    <field name="can_cancel_request" invisible="1"/>
                    <field name="can_reset_request" invisible="1"/>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary"
                        invisible="not can_submit_request"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                        invisible="not can_approve_request"/>
                    <button name="action_refuse" string="Refuse" type="object"
                        invisible="not can_refuse_request"/>
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="not can_cancel_request"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                        invisible="not can_reset_request"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,submitted,manager_approved,upper_manager_approved,hr_approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_approval_lines" type="object" class="oe_stat_button" icon="fa-check-square-o"
                            invisible="approval_line_count == 0">
                            <field name="approval_line_count" widget="statinfo" string="Approvals"/>
                        </button>
                        <button name="action_view_calendar_leave" type="object" class="oe_stat_button" icon="fa-sun-o"
                            invisible="not calendar_leave_id">
                            <span class="o_stat_text">Public Holiday</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                        <h2><field name="name" readonly="state != 'draft'"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="calendar_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="current_approver_id" readonly="1"/>
                            <field name="calendar_leave_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" readonly="state != 'draft'"/>
                    </group>
                    <notebook>
                        <page string="Approval History" name="approval_history">
                            <field name="approval_line_ids" readonly="1">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="role"/>
                                    <field name="approver_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="decision_date"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_exceptional_holiday_view_search" model="ir.ui.view">
        <field name="name">hr.exceptional.holiday.search</field>
        <field name="model">hr.exceptional.holiday</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="To Approve" name="filter_to_approve" domain="[('state', 'in', ('submitted', 'manager_approved', 'upper_manager_approved'))]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'hr_approved')]"/>
                <filter string="Refused" name="filter_refused" domain="[('state', '=', 'refused')]"/>
                <group>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Requester" name="group_employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_exceptional_holiday" model="ir.actions.act_window">
        <field name="name">Exceptional Holidays</field>
        <field name="res_model">hr.exceptional.holiday</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_exceptional_holiday_view_search"/>
        <field name="context">{'search_default_filter_to_approve': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an exceptional public holiday request
            </p>
            <p>
                Requests go through manager and HR approval before becoming a live public holiday.
            </p>
        </field>
    </record>

</odoo>
