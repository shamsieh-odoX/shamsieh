<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_exceptional_holiday_rule_company" model="ir.rule">
        <field name="name">Exceptional Holiday: multi-company</field>
        <field name="model_id" ref="model_hr_exceptional_holiday"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="hr_leave_balance_summary_rule_company" model="ir.rule">
        <field name="name">Leave Balance Summary: multi-company</field>
        <field name="model_id" ref="model_hr_leave_balance_summary"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
