# Odoo.sh connection (copy this file to .env and fill in values)
# NEVER commit a real .env with API keys.
ODOO_URL=https://shamsieh.odoo.com
ODOO_DB=shamsieh-odox-shamsieh-production-33677101
ODOO_BOT_USER=m.saqer@shamsieh.com
ODOO_API_KEY=your_api_key_from_odoo_preferences

# Bridge — device HTTP Listening Host should point here, e.g. http://<pc-lan-ip>:8080/hikvision/attendance
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
VERBOSE_LOGGING=true
DEFAULT_EVENT_TIMEZONE=Asia/Amman
RETRY_INTERVAL_SECONDS=30
